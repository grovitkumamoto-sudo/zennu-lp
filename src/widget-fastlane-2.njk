  <script src="https://zennuwellnessdesign.hacomono.jp/js/widget.js"></script>
  {% include "click-tracking.njk" %}
  <script>
    (() => {
      const primary = document.getElementById("fast-primary");
      const reserve = document.getElementById("reserve");
      const sticky = document.getElementById("fast-sticky");
      let primaryVisible = true;
      let reserveVisible = false;
      const updateSticky = () => sticky.classList.toggle("is-hidden", primaryVisible || reserveVisible);
      new IntersectionObserver(entries => {
        primaryVisible = entries[0].isIntersecting;
        updateSticky();
      }, { threshold: .1 }).observe(primary);
      new IntersectionObserver(entries => {
        reserveVisible = entries[0].isIntersecting;
        updateSticky();
      }, { threshold: .08 }).observe(reserve);
    })();
  </script>
