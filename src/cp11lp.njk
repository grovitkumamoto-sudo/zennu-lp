  <script>
    (() => {
      const header = document.querySelector('.ix001-header');
      const toggle = header.querySelector('.ix001-menu-toggle');
      const menu = header.querySelector('.ix001-menu');
      const closeMenu = () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'メニューを開く');
      };
      toggle.addEventListener('click', () => {
        const opening = menu.hidden;
        menu.hidden = !opening;
        toggle.setAttribute('aria-expanded', String(opening));
        toggle.setAttribute('aria-label', opening ? 'メニューを閉じる' : 'メニューを開く');
      });
      menu.addEventListener('click', event => { if (event.target.closest('a')) closeMenu(); });
      document.addEventListener('pointerdown', event => { if (!header.contains(event.target)) closeMenu(); });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape' || menu.hidden) return;
        closeMenu();
        toggle.focus();
      });
    })();
  </script>
