  .trainer-card-role{color:var(--mint);font:700 9px/1 var(--latin);letter-spacing:.2em}
  .trainer-card-summary h2{margin:24px 0 10px;font-size:clamp(42px,5vw,68px)}
  .trainer-card-summary h2 small{display:block;margin-top:11px;color:var(--muted);font:600 10px/1 var(--latin);letter-spacing:.16em}
  .trainer-card-summary>p{margin:28px 0 0;color:var(--muted);font-size:13px;line-height:2}
  .trainer-card-toggle{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:38px;padding-top:22px;border-top:1px solid var(--line);font-size:11px;font-weight:700}
