  @media(max-width:980px){
    .home-service-card{grid-column:span 3}.home-service-card:last-child{grid-column:1/-1}.home-service-card:last-child{display:grid;grid-template-columns:1fr 1fr}.home-service-card:last-child figure{height:100%}
    .home-voices-heading{grid-template-columns:1fr;gap:30px}.home-voice-card figure{height:280px}.home-voice-card>div{min-height:245px}
  }
  @media(max-width:760px){
    .home-service .section-heading-row{margin-bottom:24px}.home-service-lead{margin-bottom:40px!important;font-size:12px}.home-service-lead br{display:none}
    .home-service-grid{grid-template-columns:1fr;gap:14px}.home-service-card,.home-service-card--training,.home-service-card:last-child{grid-column:auto;display:block}.home-service-card figure,.home-service-card--training figure,.home-service-card:last-child figure{height:68vw;min-height:250px;max-height:350px}.home-service-duo,.home-service-facility{display:grid!important;grid-template-columns:1fr 1fr}.home-service-card>div,.home-service-card--training>div{display:block;min-height:230px;padding:26px 24px 30px}.home-service-card h3,.home-service-card--training h3{font-size:28px}.home-service-card p,.home-service-card--training p{font-size:11px}.home-service-card i{right:24px;bottom:24px}.home-service-duo b{bottom:14px;left:12px;padding:8px 9px;font-size:7px}.home-service-modes{margin-top:22px;padding-right:28px}
    .home-voices-heading{display:block;margin-bottom:44px}.home-voices-heading h2{font-size:37px}.home-voices-heading>div:last-child{margin-top:26px}.home-voices-heading>div:last-child p{font-size:12px}.home-voices-grid{display:flex;gap:14px;overflow-x:auto;margin-right:-18px;padding-right:18px;scroll-snap-type:x mandatory;scrollbar-width:none}.home-voices-grid::-webkit-scrollbar{display:none}.home-voice-card,.home-voice-card--offset{flex:0 0 86%;margin:0;scroll-snap-align:start}.home-voice-card figure{height:62vw;min-height:240px;max-height:330px}.home-voice-card>div{min-height:190px;padding:25px}.home-voice-card blockquote{font-size:14px;line-height:1.9}
  }

  /* Editorial line control and a more balanced TRAINING card */
  .home-feature-heading{grid-template-columns:.28fr 1.42fr .58fr}
  .home-service-card--training{grid-template-columns:minmax(0,1.12fr) minmax(410px,.88fr)}
  .home-service-card--training h3{font-size:clamp(38px,3.45vw,52px)}
  .home-service-card--training h3 b{display:block;white-space:nowrap}

  /* SPACE — Kamitori context followed by a moving preview of the full gallery */
  .home-space{min-height:0;padding:clamp(88px,10vw,150px) 0 0;overflow:hidden;background:var(--ink);color:#fff}
  .home-space-heading{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-bottom:42px}
  .home-space-heading .section-label{margin:0}
  .home-space-heading>p{margin:0;color:rgba(255,255,255,.48);font:700 9px/1 var(--latin);letter-spacing:.22em}
  .home-space-arcade{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(360px,.78fr);min-height:610px;background:#242423}
  .home-space-arcade figure{position:relative;min-height:610px;margin:0;overflow:hidden}
  .home-space-arcade figure::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 54%,rgba(15,15,15,.24)),linear-gradient(0deg,rgba(15,15,15,.22),transparent 55%)}
  .home-space-arcade figure img{width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.72) contrast(1.06)}
  .home-space-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(44px,5.5vw,82px)}
  .home-space-copy>span{color:var(--mint);font:700 9px/1 var(--latin);letter-spacing:.22em}
