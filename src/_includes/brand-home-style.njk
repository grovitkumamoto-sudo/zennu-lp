  /* ACCESS — location and movement */
  .access-intro{padding:clamp(78px,9vw,128px) 0;background:var(--ink);color:#fff}
  .access-intro-grid{display:grid;grid-template-columns:1.12fr .65fr;gap:clamp(40px,6vw,88px);align-items:end}
  .access-intro-grid>div:first-child>span{color:var(--mint);font:700 9px/1 var(--latin);letter-spacing:.24em}
