  .home-service-card h3{margin:20px 0 18px;font-size:clamp(24px,2.2vw,32px);line-height:1.45;letter-spacing:-.045em}
  .home-service-card p{margin:0;padding-right:24px;color:var(--muted);font-size:11px;line-height:1.9}
