  .home-intro-copy>p:not(.home-intro-en):not(.home-intro-lead){max-width:490px;color:var(--muted);font-size:14px;line-height:2.15}
  .home-intro-link{display:inline-flex;align-items:center;gap:20px;margin-top:36px;font-size:12px;font-weight:700}
  .home-intro-link i{display:grid;width:58px;height:58px;place-items:center;border-radius:50%;background:var(--ink);color:#fff;font:normal 18px/1 var(--latin);transition:transform .25s,background .25s}
