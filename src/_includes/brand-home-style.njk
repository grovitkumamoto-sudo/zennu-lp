  .home-space-copy p{margin:0;color:#d2d2cf;font-size:13px;line-height:2.05}
  .home-space-copy .text-link{align-self:flex-start;margin-top:28px}
  .home-space-gallery{width:100%;padding:24px 0 30px;overflow:hidden;background:#101010}
  .home-space-track{display:flex;width:max-content;animation:space-gallery-flow 44s linear infinite;will-change:transform}
  .home-space-gallery:hover .home-space-track{animation-play-state:paused}
  .home-space-group{display:flex;gap:18px;padding-right:18px}
  .home-space-card{position:relative;display:block;width:330px;height:220px;flex:none;overflow:hidden;background:#2a2a29}
  .home-space-card--wide{width:440px}
  .home-space-card img{width:100%;height:100%;object-fit:cover;filter:saturate(.72) contrast(1.05);transition:transform .6s,filter .4s}
  .home-space-card:hover img{transform:scale(1.035);filter:saturate(.9) contrast(1.04)}
  .home-space-card::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(12,12,12,.62),transparent 52%)}
