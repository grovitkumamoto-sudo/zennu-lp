<style>
  :root{--ink:#191919;--ink-2:#343434;--paper:#f2f2ef;--white:#fff;--mint:#b49a64;--sky:#d3c5a5;--coral:#e9782d;--line:rgba(25,25,25,.16);--muted:#666664;--shell:min(1240px,calc(100% - 64px));--sans:"Noto Sans JP",sans-serif;--latin:"Manrope",sans-serif}
