  .home-feature-item--result .home-feature-panel{right:0;bottom:-82px;width:78%;padding:50px 38px 34px;border-top:7px solid var(--sky)}
  .home-feature-item--result .home-feature-index{top:-54px;left:-9px}
  .home-feature-item--continue{bottom:0;left:18%;width:66%;height:430px}
  .home-feature-item--continue::before{content:"CONTINUE";position:absolute;z-index:3;top:12px;right:-24px;color:rgba(255,255,255,.78);font:700 9px/1 var(--latin);letter-spacing:.3em;writing-mode:vertical-rl}
  .home-feature-item--continue .home-feature-photo{width:58%;margin-left:auto}
