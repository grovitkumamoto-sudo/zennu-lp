  /* OUR FEATURE — asymmetric editorial photography */
  .home-feature{position:relative;overflow:hidden;background:#efefec}
  .home-feature::before{content:"ZENNU";position:absolute;top:8%;right:-.05em;color:rgba(25,25,25,.035);font:800 min(22vw,320px)/.8 var(--latin);letter-spacing:-.08em;pointer-events:none}
