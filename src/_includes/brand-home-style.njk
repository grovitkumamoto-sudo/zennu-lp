  /* CUSTOMER VOICE — real member photography and handwritten comments */
  .home-voices{overflow:hidden;background:#fff}
  .home-voices-heading{display:grid;grid-template-columns:1fr .55fr;gap:clamp(54px,8vw,120px);align-items:end;margin-bottom:72px}
