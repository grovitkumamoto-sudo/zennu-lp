  /* TRAINERS — shared lower-page visual language with expandable proof */
  .lower-visual-hero{position:relative;height:min(78vh,760px);min-height:620px;overflow:hidden;background:#181818;color:#fff}
  .lower-visual-hero>img{width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.72) contrast(1.08)}
  .lower-visual-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(14,14,14,.64),rgba(14,14,14,.08) 68%),linear-gradient(90deg,rgba(14,14,14,.2),transparent 66%)}
  .lower-visual-copy{position:absolute;z-index:1;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center}
