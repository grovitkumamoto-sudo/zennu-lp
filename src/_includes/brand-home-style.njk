<style>
  :root{--ink:#15292d;--ink-2:#254147;--paper:#f6f4ef;--white:#fff;--mint:#72cdb0;--sky:#68bfe0;--coral:#ff6c4a;--line:rgba(21,41,45,.16);--muted:#647579;--shell:min(1240px,calc(100% - 64px));--sans:"Noto Sans JP",sans-serif;--latin:"Manrope",sans-serif}
