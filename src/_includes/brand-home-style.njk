  .trainer-quality-en{margin:0 0 25px!important;color:var(--mint);font:700 9px/1 var(--latin);letter-spacing:.24em}
  .trainer-quality-heading h2{margin:0;font-size:clamp(38px,4vw,58px);line-height:1.28}
  .trainer-quality-heading>p{margin:0;color:var(--muted);font-size:13px;line-height:2.1}
  .trainer-quality-grid{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .trainer-quality-grid article{position:relative;display:flex;min-height:540px;flex-direction:column;overflow:hidden;padding:38px 34px 36px;background:#fff}
