  .trainer-quality-grid article:nth-child(2)>strong,.trainer-quality-grid article:nth-child(3)>strong{color:rgba(255,255,255,.08)}
  .trainer-quality-grid h3{position:relative;z-index:1;margin:auto 0 24px;font-size:clamp(25px,2.3vw,34px);line-height:1.5;letter-spacing:-.045em}
