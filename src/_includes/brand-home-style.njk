  /* PRICE — route-first editorial page */
  .price-manifesto{padding:clamp(78px,9vw,130px) 0;background:var(--ink);color:#fff}
  .price-manifesto-grid{display:grid;grid-template-columns:1.12fr .65fr;gap:clamp(40px,6vw,88px);align-items:end}
  .price-manifesto-grid>div:first-child>span{color:var(--mint);font:700 9px/1 var(--latin);letter-spacing:.24em}
