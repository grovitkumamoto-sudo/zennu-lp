  .facility-gallery-item:hover img{transform:scale(1.025)}
  .facility-gallery-item::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(12,12,12,.58),transparent 48%)}
  .facility-gallery-item span{position:absolute;z-index:1;right:17px;bottom:16px;left:17px;color:#fff;font:700 8px/1 var(--latin);letter-spacing:.18em}

  @media(max-width:980px){
    .home-feature-heading{grid-template-columns:.28fr 1.2fr}.home-feature-intro{grid-column:2}
    .home-service-card--training{grid-template-columns:1fr 1fr}
