  .site-header{position:fixed;z-index:80;top:0;left:0;display:grid;width:100%;height:84px;grid-template-columns:220px 1fr auto;align-items:center;padding:0 0 0 28px;border-bottom:1px solid var(--line);background:rgba(246,244,239,.94);color:var(--ink);backdrop-filter:blur(14px);transition:height .3s,background .3s,border-color .3s,color .3s}.site-logo img{width:194px;transition:filter .3s}.site-nav{display:flex;align-items:center;justify-content:center;gap:clamp(16px,1.7vw,28px);font-size:11px;font-weight:600}.site-nav a{position:relative;padding:32px 0}.site-nav a::after{content:"";position:absolute;right:0;bottom:24px;left:0;height:1px;background:currentColor;transform:scaleX(0);transition:transform .2s}.site-nav a:hover::after,.site-nav a[aria-current="page"]::after{transform:scaleX(1)}.site-header-cta{display:flex;min-width:168px;height:84px;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:0 20px;background:var(--coral);color:#fff;font-weight:800}.site-header-cta small{font:700 8px/1 var(--latin);letter-spacing:.2em}.site-header-cta strong{font-size:12px}.site-menu-button{display:none;width:52px;height:84px;border:0;border-left:1px solid currentColor;background:transparent;color:currentColor}.site-menu-button i{display:block;width:24px;height:1px;margin:7px auto;background:currentColor;transition:transform .25s}.site-menu-button[aria-expanded="true"] i:first-child{transform:translateY(4px) rotate(45deg)}.site-menu-button[aria-expanded="true"] i:last-child{transform:translateY(-4px) rotate(-45deg)}.site-header--overlay{border-color:rgba(255,255,255,.35);background:linear-gradient(180deg,rgba(8,22,25,.34),rgba(8,22,25,0));color:#fff;backdrop-filter:none}.site-header--overlay .site-logo img{filter:brightness(0) invert(1)}.site-header--overlay.is-scrolled{height:72px;border-color:var(--line);background:rgba(246,244,239,.95);color:var(--ink);backdrop-filter:blur(14px)}.site-header--overlay.is-scrolled .site-logo img{filter:none}.site-hea