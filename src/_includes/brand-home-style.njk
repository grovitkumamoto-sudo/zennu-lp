  /* Reusable trainer proof for every lower page */
  .site-trainer-feature{position:relative;overflow:hidden;padding:clamp(92px,10vw,150px) 0;background:#171717;color:#fff}
  .site-trainer-feature-watermark{position:absolute;right:-24px;bottom:-22px;color:rgba(255,255,255,.035);font:800 clamp(100px,17vw,280px)/.75 var(--latin);letter-spacing:-.075em;pointer-events:none}
  .site-trainer-feature-grid{position:relative;display:grid;grid-template-columns:minmax(360px,.74fr) 1.26fr;gap:clamp(56px,8vw,120px);align-items:center}
