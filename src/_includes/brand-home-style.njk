  .site-trainer-feature-visual figure:nth-child(2){height:510px}
  .site-trainer-feature-visual img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:saturate(.72) contrast(1.06)}
  .site-trainer-feature-visual figure::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(12,12,12,.76),transparent 42%)}
  .site-trainer-feature-visual figcaption{position:absolute;z-index:1;right:20px;bottom:20px;left:20px;font:700 11px/1.4 var(--latin);letter-spacing:.13em}
  .site-trainer-feature-visual figcaption small{display:block;margin-top:8px;color:rgba(255,255,255,.62);font-size:7px;letter-spacing:.16em}

  .facility-visual-hero>img{object-position:center 52%}
  .facility-gallery-heading{display:grid;grid-template-columns:.55fr 1fr;gap:70px;align-items:end;margin-bottom:58px}
  .facility-gallery-heading .section-label{margin:0;color:var(--mint)}
  .facility-gallery-heading h2{margin:0;font-size:clamp(38px,4.5vw,64px)}
  .facility-gallery-heading p{max-width:620px;margin:22px 0 0;color:var(--muted);font-size:13px;line-height:2}
  .facility-gallery{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:250px;gap:14px}
  .facility-gallery-item{position:relative;grid-column:span 4;overflow:hidden;background:#ddd}
  .facility-gallery-item--main{grid-column:span 7;grid-row:span 2}
