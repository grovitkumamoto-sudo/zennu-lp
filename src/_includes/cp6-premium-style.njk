<style>
  :root {
    --sg-navy: #0c1e33;
    --sg-navy-2: #17283b;
    --sg-gold: #a79872;
    --sg-gold-light: #d8c997;
    --sg-cream: #f1eee6;
    --sg-ink: #1d2839;
    --sg-line: rgba(29,40,57,.2);
    --sg-white: #fff;
  }
  *,*::before,*::after{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body.sglp{margin:0;padding:0 0 94px;background:#fff;color:var(--sg-ink);font-family:"Noto Sans JP",sans-serif;font-size:16px;font-weight:400;line-height:1.9;letter-spacing:.025em;-webkit-font-smoothing:antialiased}
  .sglp img{display:block;max-width:100%}
  .sglp a{color:inherit;text-decoration:none}
  .sglp h1,.sglp h2,.sglp h3,.sglp p{margin-top:0}
  .sglp button,.sglp summary{font:inherit}
  .sglp section{position:relative}
  .sg-inner{width:min(1120px,calc(100% - 40px));margin-inline:auto}

  .sg-heading{margin-bottom:44px}
  .sg-heading>p{margin:0 0 11px;color:var(--sg-gold);font:500 14px/1 "EB Garamond",serif;letter-spacing:.22em}
  .sg-heading h2{margin:0;font-family:"Noto Serif JP",serif;font-size:clamp(30px,7vw,48px);font-weight:500;line-height:1.55;letter-spacing:-.035em}
  .sg-heading>span{display:block;margin-top:14px;color:#6b7180;font-size:14px;line-height:1.8}
  .sg-heading-center{text-align:center}
  .sg-heading-light h2{color:#fff}
  .sg-note{margin:18px 0 0;color:#74766f;font-size:12px;line-height:1.8;text-align:center}
  .sg-left{text-align:left}

  .sg-hero{height:max(720px,100svh);overflow:hidden;background:#05080c;color:#fff}
  .sg-hero-image,.sg-hero-shade{position:absolute;inset:0;width:100%;height:100%}
  .sg-hero-image{object-fit:cover;object-position:64% center;filter:saturate(.58) contrast(1.04)}
  .sg-hero-shade{background:linear-gradient(180deg,rgba(1,8,16,.62) 0%,rgba(3,12,22,.1) 36%,rgba(3,11,20,.84) 100%),linear-gradient(90deg,rgba(4,14,25,.62),transparent 72%)}
  .sg-hero-logo{position:absolute;z-index:1;top:24px;left:22px;width:150px}
  .sg-hero-logo img{filter:brightness(0) invert(1)}
  .sg-hero-copy{position:absolute;z-index:1;top:132px;left:22px;width:calc(100% - 44px)}
  .sg-kicker{margin:0 0 18px;color:var(--sg-gold-light);font:500 12px/1.4 "Barlow Condensed",sans-serif;letter-spacing:.18em}
  .sg-hero-copy h1{margin:0 0 18px;font-family:"Noto Serif JP",serif;font-size:clamp(35px,10vw,55px);font-weight:500;line-height:1.48;letter-spacing:-.045em;text-shadow:0 2px 18px rgba(0,0,0,.4)}
  .sg-hero-copy h1 span{display:block;font-size:.88em;white-space:nowrap}
  .sg-hero-copy>p:last-child{margin:0;color:rgba(255,255,255,.76);font-size:14px;line-height:2}
  .sg-hero-brand{position:absolute;z-index:1;left:22px;bottom:245px;padding-left:14px;border-left:1px solid var(--sg-gold-light)}
  .sg-hero-brand span{display:block;margin-bottom:4px;color:var(--sg-gold-light);font:500 12px/1 "EB Garamond",serif;letter-spacing:.18em}
  .sg-hero-brand strong{font:500 17px/1.45 "Barlow Condensed",sans-serif;letter-spacing:.16em}
  .sg-hero-offer{position:absolute;z-index:2;right:20px;bottom:92px;left:20px;display:grid;grid-template-columns:1fr auto;align-items:center;padding:14px 16px;border:1px solid rgba(255,255,255,.65);background:rgba(12,30,51,.9);box-shadow:0 14px 40px rgba(0,0,0,.24);backdrop-filter:blur(7px)}
  .sg-hero-offer span{grid-column:1/-1;margin-bottom:3px;color:var(--sg-gold-light);font-size:12px;font-weight:600;letter-spacing:.06em}
  .sg-hero-offer strong{font-family:"Noto Serif JP",serif;font-size:21px;font-weight:500}
  .sg-hero-offer strong b{color:var(--sg-gold-light);font:500 36px/1 "EB Garamond",serif}
  .sg-hero-offer small{align-self:end;color:rgba(255,255,255,.72);font-size:11px;line-height:1.5;text-align:right}

  .sg-proof{display:grid;grid-template-columns:repeat(3,1fr);background:var(--sg-gold-light);color:var(--sg-navy)}
  .sg-proof>div{display:flex;min-height:104px;align-items:center;justify-content:center;flex-direction:column;padding:14px 4px;border-right:1px solid rgba(12,30,51,.24);text-align:center}
  .sg-proof>div:last-child{border-right:0}
  .sg-proof b{font:500 clamp(24px,7vw,38px)/1 "EB Garamond",serif;white-space:nowrap}
  .sg-proof b small{font-family:"Noto Sans JP",sans-serif;font-size:11px;font-weight:600}
  .sg-proof span{margin-top:9px;font-size:11px;font-weight:600;letter-spacing:.08em}

  .sg-reviews{padding:92px 0;background:#fff}
  .sg-review-scroll{display:flex;overflow-x:auto;gap:14px;margin-right:-20px;padding:0 20px 14px 0;scroll-snap-type:x mandatory;scrollbar-width:none}
  .sg-review-scroll::-webkit-scrollbar{display:none}
  .sg-review-card{min-width:min(84vw,370px);padding:25px 22px 28px;border:1px solid var(--sg-line);background:#fff;scroll-snap-align:start}
  .sg-review-person{display:flex;align-items:center;gap:13px;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid var(--sg-line)}
  .sg-review-person img{width:50px;height:50px;border-radius:50%;object-fit:cover;filter:grayscale(.25)}
  .sg-review-person p{margin:0}
  .sg-review-person b{display:block;color:var(--sg-navy);font-size:13px}
  .sg-review-person span{display:block;margin-top:3px;color:var(--sg-gold);font-size:12px;letter-spacing:.12em}
  .sg-review-card h3{margin:0 0 14px;font-family:"Noto Serif JP",serif;font-size:19px;font-weight:500;line-height:1.75}
  .sg-review-card>p{margin:0;color:#626a76;font-size:13px;line-height:2}

  .sg-comparison{padding:94px 0;background:var(--sg-navy);color:#fff}
  .sg-table-wrap{overflow-x:auto;border:1px solid rgba(255,255,255,.2);scrollbar-color:var(--sg-gold) transparent}
  .sg-comparison table{width:100%;min-width:720px;border-collapse:collapse;text-align:center;table-layout:fixed}
  .sg-comparison th,.sg-comparison td{height:82px;padding:13px 11px;border-right:1px solid rgba(255,255,255,.17);border-bottom:1px solid rgba(255,255,255,.17);font-size:13px;line-height:1.65}
  .sg-comparison thead th{height:88px;color:rgba(255,255,255,.75);font:500 15px/1.45 "Noto Serif JP",serif}
  .sg-comparison th:first-child{width:120px;color:var(--sg-gold-light);font-size:12px;font-weight:500;letter-spacing:.04em}
  .sg-comparison .is-zennu{background:var(--sg-gold-light);color:var(--sg-navy);font-weight:600}
  .sg-comparison thead .is-zennu{font:600 25px/1 "Barlow Condensed",sans-serif;letter-spacing:.06em}
  .sg-comparison td strong{font-family:"Noto Serif JP",serif;font-size:16px;font-weight:600}
  .sg-comparison-note{margin:12px 0 0;color:rgba(255,255,255,.55);font-size:10px;text-align:center}

  .sg-campaign{padding:54px 0 82px;background:#e8e9eb}
  .sg-campaign-board{margin-bottom:24px;padding:24px 16px 18px;border:1px solid #ad9b65;border-radius:6px;background:#fff;color:var(--sg-navy)}
  .sg-campaign-head{padding-bottom:17px;border-bottom:1px solid #ad9b65;text-align:center}
  .sg-campaign-head p{margin:0 0 6px;color:var(--sg-gold);font:500 10px/1 "EB Garamond",serif;letter-spacing:.2em}
  .sg-campaign-head h2{margin:0;color:#9c916f;font-size:clamp(20px,6.3vw,36px);font-weight:800;line-height:1.4;letter-spacing:-.04em}
  .sg-campaign-lead{display:flex;align-items:flex-end;justify-content:center;gap:4px;padding:20px 0 18px;text-align:center;white-space:nowrap}
  .sg-campaign-lead span{align-self:center;font-size:12px;font-weight:800}
  .sg-campaign-lead strong{padding-bottom:5px;font-size:15px;font-weight:800}
  .sg-campaign-lead b{color:#bd962c;font:600 66px/.78 "EB Garamond",serif;letter-spacing:-.06em}
  .sg-campaign-lead em{padding-bottom:2px;color:#bd962c;font-size:17px;font-style:normal;font-weight:800}
  .sg-campaign-grid{display:grid;gap:8px}
  .sg-campaign-grid article{display:grid;grid-template-columns:38px 1fr;min-height:102px;align-items:center;padding:12px 13px;border-radius:4px;background:var(--sg-navy);color:#fff}
  .sg-campaign-grid article>span{color:rgba(255,255,255,.67);font:500 38px/1 "Barlow Condensed",sans-serif;text-align:center}
  .sg-campaign-grid article>div{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:5px 8px;text-align:center}
  .sg-campaign-grid article p{width:100%;margin:0;font-size:13px;font-weight:600;line-height:1.35}
  .sg-campaign-grid article p s{color:rgba(255,255,255,.7);font-size:11px}
  .sg-campaign-grid article i{color:var(--sg-gold-light);font-size:11px;font-style:normal;font-weight:700}
  .sg-campaign-grid article strong{color:#d1aa3e;font:600 47px/.9 "EB Garamond",serif;letter-spacing:-.04em}
  .sg-campaign-grid article strong small{font-family:"Noto Sans JP",sans-serif;font-size:13px;font-weight:700}
  .sg-campaign-grid .sg-campaign-gift strong{font-family:"Noto Serif JP",serif;font-size:23px;line-height:1.25;letter-spacing:-.03em}
  .sg-campaign-caution{margin:15px 0 0;color:#4a4e55;font-size:9px;line-height:1.7;text-align:center}
  .sg-button{display:grid;min-height:78px;grid-template-columns:1fr auto;align-items:center;width:min(720px,100%);margin:0 auto;padding:14px 18px 14px 22px;border:1px solid var(--sg-navy);background:var(--sg-navy);color:#fff;font-size:17px;font-weight:600;line-height:1.45;letter-spacing:.04em}
  .sg-button>span{grid-column:1;margin-bottom:2px;color:var(--sg-gold-light);font-size:12px;font-weight:500;letter-spacing:.08em}
  .sg-button>i{grid-column:2;grid-row:1/3;font-family:"EB Garamond",serif;font-size:30px;font-style:normal;font-weight:400}

  .sg-concept{padding:94px 0;background:#fff}
  .sg-concept-grid{display:grid;gap:34px}
  .sg-vertical{margin:0 0 18px;color:var(--sg-gold);font:500 12px/1.4 "Barlow Condensed",sans-serif;letter-spacing:.22em}
  .sg-concept h2{margin:0;font-family:"Noto Serif JP",serif;font-size:clamp(33px,9vw,58px);font-weight:500;line-height:1.55;letter-spacing:-.05em}
  .sg-concept-copy{padding-top:30px;border-top:1px solid var(--sg-line)}
  .sg-concept-copy p{margin:0 0 20px;color:#5f6772;line-height:2.1}
  .sg-concept-copy strong{display:block;padding-left:17px;border-left:2px solid var(--sg-gold);font-family:"Noto Serif JP",serif;font-size:19px;font-weight:500;line-height:2}

  .sg-services{padding:90px 0 0;background:var(--sg-navy)}
  .sg-service-list{display:grid}
  .sg-service{position:relative;min-height:620px;overflow:hidden;border-top:1px solid rgba(255,255,255,.18);color:#fff}
  .sg-service img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(1.02)}
  .sg-service::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,15,27,.93) 0%,rgba(4,15,27,.12) 68%)}
  .sg-service>div{position:absolute;z-index:1;right:24px;bottom:42px;left:24px}
  .sg-service span{color:var(--sg-gold-light);font:500 13px/1 "Barlow Condensed",sans-serif;letter-spacing:.18em}
  .sg-service h3{margin:13px 0 15px;font-family:"Noto Serif JP",serif;font-size:31px;font-weight:500;line-height:1.5;letter-spacing:-.04em}
  .sg-service p{margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:2}

  .sg-reasons{padding:76px 0 0;background:var(--sg-navy);color:#fff}
  .sg-reason-title{padding-bottom:60px;text-align:center}
  .sg-reason-title header{padding:24px 16px;border:1px solid rgba(255,255,255,.8)}
  .sg-reason-title p{margin:0 0 10px;color:var(--sg-gold-light);font:500 12px/1 "EB Garamond",serif;letter-spacing:.22em}
  .sg-reason-title h2{margin:0;font-family:"Noto Serif JP",serif;font-size:clamp(25px,7vw,43px);font-weight:500;line-height:1.5;letter-spacing:-.035em}
  .sg-reason-title h2 strong{font:600 1.2em/1 "Barlow Condensed",sans-serif;letter-spacing:.12em}
  .sg-reason-list{width:min(1120px,100%);margin-inline:auto}
  .sg-reason-panel{position:relative;padding:0 20px 66px;background:linear-gradient(135deg,rgba(255,255,255,.04),transparent 60%)}
  .sg-reason-panel::after{content:"";position:absolute;right:20px;bottom:34px;left:20px;height:1px;background:rgba(255,255,255,.17)}
  .sg-reason-panel img{width:100%;aspect-ratio:4/3;object-fit:cover;filter:saturate(.72) contrast(1.02)}
  .sg-reason-panel>div{position:relative;padding:24px 0 0 74px}
  .sg-reason-panel span{position:absolute;top:17px;left:0;color:rgba(255,255,255,.48);font:400 62px/1 "Barlow Condensed",sans-serif;letter-spacing:-.04em}
  .sg-reason-panel h3{margin:0 0 17px;color:var(--sg-gold-light);font-family:"Noto Serif JP",serif;font-size:23px;font-weight:600;line-height:1.6;letter-spacing:-.025em}
  .sg-reason-panel p{margin:0;color:rgba(255,255,255,.78);font-size:14px;line-height:2.1}

  .sg-trainers{overflow:hidden;padding:88px 0 78px;background:linear-gradient(135deg,#f0f0ed 0%,#d7d9d7 52%,#f5f4ef 100%);color:var(--sg-navy)}
  .sg-trainer-heading{margin-bottom:42px;padding-inline:20px;text-align:center}
  .sg-trainer-heading>p{margin:0 0 9px;color:var(--sg-gold);font:500 12px/1 "EB Garamond",serif;letter-spacing:.22em}
  .sg-trainer-heading h2{margin:0 0 10px;font-family:"Noto Serif JP",serif;font-size:clamp(30px,8vw,48px);font-weight:600;line-height:1.5;letter-spacing:-.04em}
  .sg-trainer-heading>span{font-size:14px;font-weight:600}
  .sg-trainer-stage{position:relative}
  .sg-trainer-track{display:flex;overflow-x:auto;gap:18px;padding:0 13vw 14px;scroll-padding-inline:13vw;scroll-snap-type:x mandatory;scrollbar-width:none}
  .sg-trainer-track::-webkit-scrollbar{display:none}
  .sg-trainer{position:relative;flex:0 0 74vw;max-width:520px;overflow:hidden;background:#c9cccb;scroll-snap-align:center}
  .sg-trainer>img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center top;filter:saturate(.72) contrast(.96)}
  .sg-trainer>div{position:absolute;right:0;bottom:0;left:0;padding:38px 20px 18px;background:linear-gradient(0deg,rgba(6,18,31,.92),transparent);color:#fff}
  .sg-trainer>div p{margin:0 0 2px;color:var(--sg-gold-light);font-size:11px;font-weight:600}
  .sg-trainer h3{margin:0 0 3px;font-family:"Noto Serif JP",serif;font-size:24px;font-weight:600}
  .sg-trainer>div span{font:500 11px/1 "Barlow Condensed",sans-serif;letter-spacing:.16em}
  .sg-trainer-arrow{position:absolute;z-index:2;top:50%;display:grid;width:46px;height:86px;place-items:center;padding:0;border:0;background:rgba(12,30,51,.88);color:#fff;font:300 52px/1 "EB Garamond",serif;transform:translateY(-50%);cursor:pointer}
  .sg-trainer-prev{left:0}
  .sg-trainer-next{right:0}
  .sg-trainer-hint{margin:12px 0 0;color:#777e85;font:500 10px/1 "Barlow Condensed",sans-serif;letter-spacing:.2em;text-align:center}

  .sg-pricing{padding:94px 0;background:var(--sg-cream)}
  .sg-admission{display:grid;grid-template-columns:1fr auto;align-items:center;margin-bottom:25px;padding:18px 20px;border:1px solid var(--sg-line);background:#fff}
  .sg-admission span{font-size:13px;font-weight:600}
  .sg-admission strong{font:500 27px/1 "EB Garamond",serif;text-decoration:line-through;text-decoration-thickness:1px}
  .sg-admission b{grid-column:1/-1;margin-top:10px;padding-top:10px;border-top:1px solid var(--sg-line);color:var(--sg-gold);font-family:"Noto Serif JP",serif;font-size:19px;font-weight:500;text-align:center}
  .sg-price-grid{display:grid;border-top:1px solid var(--sg-line);border-left:1px solid var(--sg-line)}
  .sg-plan{position:relative;display:flex;flex-direction:column;padding:25px 20px 20px;border-right:1px solid var(--sg-line);border-bottom:1px solid var(--sg-line);background:#fff}
  .sg-plan-popular{background:var(--sg-navy);color:#fff}
  .sg-popular{position:absolute;right:0;top:0;padding:6px 10px;background:var(--sg-gold-light);color:var(--sg-navy);font:600 11px/1 "Barlow Condensed",sans-serif;letter-spacing:.1em}
  .sg-plan header{min-height:92px;padding-bottom:18px;border-bottom:1px solid var(--sg-line)}
  .sg-plan-popular header{border-bottom-color:rgba(255,255,255,.2)}
  .sg-plan h3{margin:0 0 8px;font:500 29px/1 "Barlow Condensed",sans-serif;letter-spacing:.05em}
  .sg-plan header p{margin:0;color:#6c7380;font-size:12px;line-height:1.7}
  .sg-plan-popular header p{color:rgba(255,255,255,.64)}
  .sg-plan-price{display:flex;align-items:baseline;gap:5px;padding:22px 0 18px}
  .sg-plan-price strong{color:var(--sg-gold);font:500 clamp(34px,10vw,46px)/1 "EB Garamond",serif;letter-spacing:-.03em}
  .sg-plan-price small{font-size:11px}
  .sg-plan ul{margin:0 0 22px;padding:0;list-style:none}
  .sg-plan li{padding:8px 0;border-bottom:1px solid var(--sg-line);font-size:12px}
  .sg-plan-popular li{border-bottom-color:rgba(255,255,255,.16)}
  .sg-plan li::before{content:"—";margin-right:8px;color:var(--sg-gold)}
  .sg-plan>a{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding:12px 0;border-top:1px solid currentColor;font-size:12px;font-weight:600}
  .sg-plan>a span{font:400 22px/1 "EB Garamond",serif}
  .sg-ticket{display:grid;gap:24px;margin-top:42px;padding:26px 20px;border:1px solid var(--sg-line);background:#fff}
  .sg-ticket>div:first-child>p{margin:0 0 9px;color:var(--sg-gold);font:500 12px/1 "Barlow Condensed",sans-serif;letter-spacing:.16em}
  .sg-ticket h3{margin:0 0 4px;font-family:"Noto Serif JP",serif;font-size:24px;font-weight:500}
  .sg-ticket>div:first-child>span{color:#727986;font-size:12px}
  .sg-ticket-list{display:grid;border-top:1px solid var(--sg-line)}
  .sg-ticket-list p{display:grid;grid-template-columns:48px 1fr auto;align-items:center;margin:0;padding:10px 0;border-bottom:1px solid var(--sg-line)}
  .sg-ticket-list b{font:500 20px/1 "EB Garamond",serif}
  .sg-ticket-list strong{font:500 21px/1 "EB Garamond",serif;text-align:right}
  .sg-ticket-list small{margin-left:10px;color:#777;font-size:10px}
  .sg-price-note{margin:18px 0 0;color:#74766f;font-size:11px;line-height:1.8}

  .sg-gallery{padding:92px 0 0;background:var(--sg-navy)}
  .sg-gallery-rail{overflow:hidden;padding:0 0 26px}
  .sg-gallery-track{display:flex;width:max-content;animation:sg-gallery-marquee 42s linear infinite}
  .sg-gallery-group{display:flex;gap:12px;padding-right:12px}
  .sg-gallery-group figure{position:relative;overflow:hidden;width:min(76vw,390px);margin:0;border:1px solid rgba(255,255,255,.16);background:var(--sg-navy-2)}
  .sg-gallery-group img{width:100%;height:260px;object-fit:cover;filter:saturate(.66);transition:transform .5s}
  .sg-gallery-group figcaption{position:absolute;right:12px;bottom:11px;left:12px;color:#fff;font:500 12px/1 "Barlow Condensed",sans-serif;letter-spacing:.14em;text-shadow:0 1px 8px #000}
  .sg-gallery-track:hover{animation-play-state:paused}
  @keyframes sg-gallery-marquee{to{transform:translateX(-50%)}}

  .sg-flow{padding:88px 0 94px;background:var(--sg-navy-2);color:#fff}
  .sglp .sg-flow-cta{display:grid;grid-template-columns:1fr auto;align-items:center;width:min(680px,100%);min-height:82px;margin:0 auto;padding:16px 20px 16px 26px;border-radius:999px;background:linear-gradient(100deg,#f3d66d,#d8c58a);color:var(--sg-navy);font-family:"Noto Serif JP",serif;font-size:19px;font-weight:600;line-height:1.5}
  .sg-flow-cta i{display:grid;width:38px;height:38px;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:12px;font-style:normal}
  .sg-flow-note{margin:12px 0 78px;color:rgba(255,255,255,.64);font-size:11px;text-align:center}
  .sg-flow .sg-heading>span{color:rgba(255,255,255,.75);font-size:15px}
  .sg-flow-list{display:grid;gap:52px;margin:0;padding:0;list-style:none}
  .sg-flow-list li{position:relative;display:grid;border:1px solid rgba(255,255,255,.72);background:rgba(255,255,255,.025)}
  .sg-flow-list li:not(:last-child)::after{content:"";position:absolute;right:50%;bottom:-38px;width:0;height:0;border-top:22px solid rgba(216,201,151,.68);border-right:38px solid transparent;border-left:38px solid transparent;transform:translateX(50%)}
  .sg-flow-copy{position:relative;padding:26px 22px 24px 93px}
  .sg-flow-copy>span{position:absolute;top:35px;left:24px;color:rgba(255,255,255,.6);font:500 10px/1 "Barlow Condensed",sans-serif;letter-spacing:.2em;writing-mode:vertical-rl}
  .sg-flow-copy>b{position:absolute;top:21px;left:42px;color:rgba(255,255,255,.5);font:400 62px/1 "Barlow Condensed",sans-serif}
