  .worry-tag b{color:#e64e49}
  .worry-scene .tag1{right:16px;top:12px}
  .worry-scene .tag2{right:8px;top:63px}
  .worry-scene .tag3{left:8px;top:8px}
  .worry-scene .tag4{left:30px;top:176px}
  .worry-scene .tag5{right:12px;bottom:13px}
  .worry-copy{font-size:14px;text-align:center}
  .solution{padding:55px 28px 0;background:#fef9f2;text-align:center}
  .solution h2{font-size:30px;line-height:1.65}
  .solution .under{border-bottom:4px solid #f35319}
  .solution p{font-size:19px;font-weight:900}
