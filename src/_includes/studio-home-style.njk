  .html-hero-message p{color:#fff800;font-size:clamp(28px,8vw,45px)}
  .html-hero-message strong{color:#fff800;font-size:clamp(34px,10vw,56px)}
  .html-hero-message span{margin-top:5px;color:#fff;font-size:clamp(25px,7.8vw,43px)}
  .html-hero-proof{position:absolute;z-index:4;left:4%;right:4%;bottom:2.5%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3.2%;align-items:center}
  .html-hero-proof>div{display:flex;aspect-ratio:1;align-items:center;justify-content:center;flex-direction:column;padding:8px;border:4px solid #ffd16c;border-radius:50%;background:linear-gradient(145deg,#ff9e44,#ff563c);box-shadow:inset 0 0 0 2px #fff;color:#fff;text-align:center}
