  .amenity-list{display:grid;gap:14px}
  .amenity-item{display:grid;grid-template-columns:64px 1fr;border:2px solid #e75000;background:rgba(255,255,255,.92)}
  .amenity-item img{width:64px;height:100%;object-fit:contain;background:#ef5c21}
  .amenity-copy{padding:7px 12px}
  .amenity-copy b{display:block;color:#e75000}
  .amenity-copy span{font-size:12px}
  .price-intro{padding:55px 22px 30px}
  .admission{margin:20px 0;padding:7px 16px 15px;background:#fff;text-align:center}
  .admission b{display:block;margin:0 -16px 13px;background:#393d41;color:#fff;font-size:22px}
  .admission strong{font-size:37px}
  .price-group-title{margin:28px 0 20px;font-size:24px;text-align:center}
  .plan-list{display:grid;gap:13px}
  .plan{background:#fff;text-align:center}
  .plan h3{margin:0;padding:7px;background:linear-gradient(90deg,#f28a32,#e92315);color:#fff;font-size:24px}
  .plan .price{padding:8px;font-size:20px;font-weight:900}
  .plan .price strong{font-size:35px}
