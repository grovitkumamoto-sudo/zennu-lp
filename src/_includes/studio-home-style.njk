  .feature-card{position:relative;padding:14px;background:#fff;box-shadow:0 6px 14px rgba(0,0,0,.14)}
  .feature-no{position:absolute;left:0;top:0;z-index:2;padding:4px 13px;background:#272727;color:#fff;font-size:29px;font-weight:900}
  .feature-card img{width:100%;height:259px;object-fit:cover}
  .feature-card h3{margin:15px 0 12px;font-size:20px;line-height:1.4;text-align:center}
  .feature-card p{margin:0;font-size:13px}
  .voice-proof{padding-bottom:0}
  .review-collage{width:488px;margin:0 -7px}
  .future-call{padding:38px 25px;background:#fff;text-align:center}
  .future-call h3{font-size:25px}
  .campaign-full{padding:20px 15px 29px;background:linear-gradient(110deg,#fd7b1d 0%,#e92315 100%);text-align:center}
  .campaign-full .campaign-ribbon{width:100%;font-size:17px}
  .benefit{position:relative;margin:17px 0;padding:22px 14px;background:#fff}
  .benefit-label{position:absolute;left:13px;top:-9px;padding:4px 8px;background:#ffd239;color:#111;font-weight:900}
  .benefit h3{margin:0 0 8px;font-size:22px}
  .benefit-deal{font-size:21px;font-weight:900}
  .benefit-deal s{font-size:17px}
  .benefit-deal strong{margin-left:16px;color:#e75000;font-size:54px}
  .guide-grid{display:grid;grid-template-columns:150px 1fr;gap:12px;align-items:center}
  .guide-grid img{width:150px}
  .guide-grid h3{font-size:17px}
  .guide-list{margin:0;padding:0;list-style:none;font-size:12px;text-align:left}
  .guide-list li{margin:5px 0}
  .reason-list{display:grid;gap:28px}
  .reason-card h3{margin:0 0 8px;font-size:18px}
  .reason-no{display:block;color:#e64e49;font-size:54px;font-weight:900;line-height:1}
  .reason-card img{width:100%;margin:10px 0}
  .reason-card p{font-size:13px}
  .continue-rate{margin:45px auto 25px;text-align:center}
  .continue-rate strong{color:#e64e49;font-size:76px;line-height:1}
  .science-box{padding:28px 16px;background:#fff}
  .science-box h3{font-size:24px;text-align:center}
  .science-list{display:grid;gap:10px;margin-top:20px}
  .science-list div{padding:14px;border:2px solid #272727;font-size:13px}
  .ba-section{padding-left:0;padding-right:0}
  .ba-section .section-title{padding:0 20px}
  .ba-note{padding:0 15px;font-size:9px}
  .ba-list{display:grid;gap:10px}
  .ba-list img{width:520px}
  .customer-reviews{padding:60px 16px;background:#393d41;color:#fff}
  .customer-card{margin:23px 0 42px;background:#fff;color:#333}
  .customer-head{display:grid;grid-template-columns:95px 1fr;gap:14px;align-items:center;padding:13px;background:#ef5c21;color:#fff}
  .customer-person{text-align:center;font-weight:900}
  .customer-person img{width:61px;margin:0 auto 4px}
  .customer-head b{font-size:14px}
  .customer-body{padding:18px;font-size:13px}
  .customer-body strong{color:#e75000}
  .customer-sign{width:160px;margin:15px auto 0}
  .secrets{padding-left:22px;padding-right:22px}
  .secret-card{margin:0 -22px;padding:46px 22px;background:#e4e1e1;text-align:center}
  .secret-card:nth-child(even){background:#fff}
  .secret-label{display:inline-block;padding:4px 22px;background:#000;color:#fff;font-size:18px;font-weight:900;transform:skew(-14deg)}
  .secret-card h3{color:#e75000;font-size:21px;line-height:1.4}
  .secret-card img{width:474px;height:245px;object-fit:cover}
  .check-list{margin:18px 0 0;padding:0;list-style:none;text-align:left}
  .check-list li{margin:10px 0;padding-left:20px;font-size:13px}
  .check-list li::before{content:"■";margin-left:-20px;margin-right:8px;color:#000}
  .amenities{padding:23px;background:rgba(255,255,255,.86);background-image:linear-gradient(rgba(255,255,255,.82),rgba(255,255,255,.82)),url("/images/studio/b360936b1d1047d2.webp");background-size:cover}
