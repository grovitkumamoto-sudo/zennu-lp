  .plan.popular{position:relative;border:3px solid #d2a42e}
  .plan.popular::before{content:"1番人気";position:absolute;right:-8px;top:-32px;display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:#b78b1c;color:#fff;font-weight:900}
  .tickets{display:grid;gap:10px}
  .ticket{display:grid;grid-template-columns:100px 1fr;align-items:center;background:#fff}
  .ticket b{padding:18px 8px;background:#393d41;color:#fff;font-size:20px;text-align:center}
  .ticket div{padding:10px}
  .ticket strong{display:block;color:#e75000;font-size:25px}
  .ticket span{font-size:10px}
  .comparison{padding:48px 16px;background:#fef9f3}
  .comparison h2{text-align:center}
  .comparison table{width:100%;border-collapse:collapse;font-size:10px;text-align:center}
  .comparison th,.comparison td{padding:9px 4px;border:1px solid #8c8c8c}
  .comparison th{background:#393d41;color:#fff}
  .comparison th:first-child{background:#fff}
  .comparison th:nth-child(2){background:#e75000}
  .comparison td:first-child{background:#ddd;font-weight:900}
  .comparison td:nth-child(2){background:#fffde9;color:#cf3d28;font-weight:800}
  .trainer-section{padding:57px 22px;background:#272727;color:#fff}
  .trainer-top{display:grid;grid-template-columns:1fr 223px;gap:12px;align-items:end}
  .trainer-name span{font-size:20px;font-weight:900}
  .trainer-name strong{display:block;font-size:36px}
  .trainer-name small{font-size:17px;font-weight:900}
  .trainer-photo{width:223px}
  .profile h3{margin-top:28px;border-bottom:1px solid #fff;font-size:22px}
  .profile p{font-size:13px}
  .story{padding:58px 23px;background:#fff}
  .story h2{font-size:26px;text-align:center}
  .story h3{margin-top:40px;font-size:24px;line-height:1.5}
  .story p{font-size:14px}
  .story img{width:474px;margin:18px 0}
  .story .quote-title{color:#e75000;font-size:31px;text-align:center}
  .principles{display:grid;gap:12px;margin:22px 0}
  .principles div{padding:12px;border:2px solid #272727;font-size:17px;font-weight:900;text-align:center}
  .flow-section{padding-left:23px;padding-right:23px}
  .flow-lead{text-align:center}
  .flow-list{display:grid;gap:28px;margin-top:30px}
  .flow-card{position:relative}
  .flow-heading{display:flex;align-items:center;gap:14px;margin-bottom:8px}
  .flow-no{display:grid;place-items:center;width:65px;height:65px;border-radius:50%;background:linear-gradient(135deg,#f08c31,#e92315);color:#fff;font-size:11px;line-height:1}
  .flow-no strong{display:block;font-size:25px}
  .flow-card h3{margin:0;font-size:24px}
  .flow-card img{width:474px;height:253px;object-fit:cover}
  .flow-card p{font-size:12px}
  .access{padding:58px 23px}
  .access img{width:474px}
  .access h3{text-align:center}
  .access-table{margin-top:18px}
  .access-row{display:grid;grid-template-columns:115px 1fr;padding:13px;background:#f5f5f5;border-bottom:1px solid #ddd;font-size:12px}
