<style>
  *,*::before,*::after{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:#d9d9d9;color:#171717;font-family:"Noto Sans JP",sans-serif;line-height:1.8;-webkit-font-smoothing:antialiased}
  img{display:block;width:100%}
  a{color:inherit;text-decoration:none}
  button{font:inherit}
  .studio-shell{position:relative;max-width:620px;margin:0 auto;background:#fff;overflow:hidden;box-shadow:0 0 34px rgba(0,0,0,.12)}
  .studio-header{position:sticky;top:0;z-index:50;display:flex;align-items:center;height:72px;background:rgba(255,255,255,.97);border-bottom:1px solid #ececec}
  .studio-logo{display:flex;align-items:center;width:44%;padding:0 18px}
  .studio-logo img{width:145px;height:auto;filter:invert(1)}
  .header-actions{display:flex;align-self:stretch;margin-left:auto}
  .header-action{display:grid;place-items:center;min-width:72px;padding:8px 10px;color:#fff;font-size:10px;font-weight:800;line-height:1.25;text-align:center}
  .header-action strong{display:block;font-family:Montserrat,sans-serif;font-size:15px;letter-spacing:.04em}
  .header-action.booking{background:#f16e32}
  .header-action.line{background:#06c755}
  .menu-button{display:grid;place-items:center;width:54px;border:0;background:#171717;color:#fff;cursor:pointer}
  .menu-button span,.menu-button::before,.menu-button::after{content:"";display:block;width:23px;height:2px;background:currentColor;transition:.2s}
  .menu-button span{margin:5px 0}
  .menu-button.open span{opacity:0}
  .menu-button.open::before{transform:translateY(7px) rotate(45deg)}
  .menu-button.open::after{transform:translateY(-7px) rotate(-45deg)}
  .studio-nav{position:fixed;z-index:48;top:72px;left:50%;width:min(620px,100%);max-height:calc(100vh - 72px);padding:24px;overflow:auto;background:#171717;color:#fff;transform:translate(-50%,-120%);transition:transform .3s ease}
  .studio-nav.open{transform:translate(-50%,0)}
  .studio-nav a{display:flex;justify-content:space-between;padding:15px 2px;border-bottom:1px solid rgba(255,255,255,.14);font-weight:700}
  .studio-nav a::after{content:"→";color:#f16e32}
  .hero-studio{position:relative;min-height:760px;color:#fff;background:#111}
  .hero-studio::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.12) 42%,rgba(0,0,0,.84)),url("/images/hero.jpg") center/cover}
  .hero-inner{position:relative;z-index:1;display:flex;min-height:760px;flex-direction:column;justify-content:flex-end;padding:40px 28px 44px}
  .hero-kicker{display:inline-flex;align-self:flex-start;margin-bottom:16px;padding:7px 12px;background:#f16e32;font-family:Montserrat,sans-serif;font-size:11px;font-weight:800;letter-spacing:.1em}
  .hero-studio h1{margin:0;font-size:clamp(34px,9vw,54px);font-weight:900;line-height:1.28;letter-spacing:.03em;text-shadow:0 2px 18px rgba(0,0,0,.4)}
  .hero-studio h1 em{display:block;color:#f47b40;font-family:Montserrat,sans-serif;font-size:.46em;font-style:normal;letter-spacing:.11em}
  .hero-lead{max-width:490px;margin:18px 0 0;font-size:15px;font-weight:700;line-height:1.9}
  .hero-proof{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:24px;background:rgba(255,255,255,.28)}
  .proof-item{padding:13px 6px;background:rgba(13,13,13,.75);text-align:center}
  .proof-item strong{display:block;color:#f47b40;font-family:Montserrat,sans-serif;font-size:25px;line-height:1.1}
  .proof-item span{font-size:9px;font-weight:700}
  .campaign-card{position:relative;margin:-20px 18px 0;padding:28px 20px;background:#f16e32;color:#fff;text-align:center;box-shadow:0 14px 30px rgba(121,50,19,.25)}
  .campaign-card::before{content:"初回限定 CAMPAIGN";display:inline-block;margin-bottom:8px;padding:4px 12px;border:1px solid rgba(255,255,255,.75);font-family:Montserrat,sans-serif;font-size:10px;font-weight:800;letter-spacing:.12em}
  .campaign-card h2{margin:0;font-size:23px;line-height:1.45}
  .campaign-price{display:flex;align-items:flex-end;justify-content:center;gap:7px;margin:10px 0 14px}
  .campaign-price s{font-size:13px}
  .campaign-price strong{font-family:Montserrat,sans-serif;font-size:42px;line-height:1}
  .campaign-button,.line-button{display:flex;align-items:center;justify-content:center;min-height:58px;padding:12px 16px;border:2px solid #171717;background:#171717;color:#fff;font-weight:900;letter-spacing:.04em;transition:.2s}
  .campaign-button::after,.line-button::after{content:"→";margin-left:12px}
  .campaign-button:hover,.line-button:hover{transform:translateY(-2px)}
  .line-button{border-color:#06c755;background:#06c755}
  .section{padding:76px 26px}
  .section--gray{background:#f3f3f3}
  .section--dark{background:#171717;color:#fff}
  .section--orange{background:#f16e32;color:#fff}
  .section-label{margin-bottom:10px;color:#f16e32;font-family:Montserrat,sans-serif;font-size:12px;font-weight:900;letter-spacing:.18em}
  .section--orange .section-label{color:#171717}
  .section-title{margin:0 0 20px;font-size:30px;font-weight:900;line-height:1.5;letter-spacing:.02em}
  .section-title .orange{color:#f16e32}
  .section-copy{margin:0;color:#555;font-size:14px}
  .section--dark .section-copy,.section--orange .section-copy{color:rgba(255,255,255,.78)}
  .worry-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:30px}
  .worry-card{min-height:134px;padding:20px 15px;background:#fff;border:1px solid #e6e6e6;text-align:center}
  .worry-icon{display:grid;place-items:center;width:44px;height:44px;margin:0 auto 10px;border-radius:50%;background:#171717;color:#fff;font-family:Montserrat,sans-serif;font-weight:900}
  .worry-card p{margin:0;font-size:12px;font-weight:700;line-height:1.65}
  .answer-panel{position:relative;margin-top:34px;padding:34px 22px;background:#171717;color:#fff}
  .answer-panel::before{content:"ANSWER";position:absolute;right:10px;top:-21px;color:#f16e32;font-family:Montserrat,sans-serif;font-size:43px;font-weight:900;letter-spacing:-.03em}
  .answer-panel h3{position:relative;margin:0 0 14px;font-size:23px;line-height:1.6}
  .answer-panel p{position:relative;margin:0;color:#d4d4d4;font-size:13px}
  .cross-word{display:flex;align-items:center;justify-content:center;gap:13px;margin:32px 0;font-size:24px;font-weight:900}
  .cross-word span{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#f16e32;color:#fff;font-family:Montserrat,sans-serif}
  .feature-list{display:grid;gap:26px;margin-top:36px}
  .feature-card{overflow:hidden;background:#fff;color:#171717}
  .feature-photo{position:relative;height:250px}
  .feature-photo img{height:100%;object-fit:cover}
  .feature-no{position:absolute;left:0;bottom:0;padding:7px 14px;background:#f16e32;color:#fff;font-family:Montserrat,sans-serif;font-size:24px;font-weight:900}
  .feature-body{padding:24px 20px 27px}
  .feature-body h3{margin:0 0 10px;font-size:21px;line-height:1.55}
  .feature-body p{margin:0;color:#606060;font-size:13px}
  .result-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:28px 0}
  .result-summary div{padding:20px 8px;border:1px solid #424242;text-align:center}
  .result-summary strong{display:block;color:#f16e32;font-family:Montserrat,sans-serif;font-size:36px;line-height:1.1}
  .result-summary span{font-size:11px}
  .ba-grid{display:grid;gap:22px}
  .ba-card{background:#fff;color:#171717}
  .ba-card img{aspect-ratio:4/3;object-fit:cover}
  .ba-card-body{padding:18px}
  .ba-card-tag{color:#f16e32;font-family:Montserrat,sans-serif;font-size:10px;font-weight:900;letter-spacing:.13em}
  .ba-card h3{margin:5px 0 5px;font-size:22px}
  .ba-card p{margin:0;color:#666;font-size:12px}
  .secret-list{display:grid;gap:18px;margin-top:30px}
  .secret-card{padding:26px 20px;background:#fff;border-top:5px solid #f16e32;box-shadow:0 8px 24px rgba(0,0,0,.06)}
  .secret-card strong{display:block;margin-bottom:9px;color:#f16e32;font-family:Montserrat,sans-serif;font-size:13px}
  .secret-card h3{margin:0 0 8px;font-size:19px}
  .secret-card p{margin:0;color:#666;font-size:13px}
  .gallery-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:28px}
  .gallery-grid figure{position:relative;margin:0;overflow:hidden}
  .gallery-grid figure:first-child{grid-column:1/-1}
  .gallery-grid img{height:190px;object-fit:cover}
  .gallery-grid figure:first-child img{height:300px}
  .gallery-grid figcaption{position:absolute;left:8px;bottom:8px;padding:4px 8px;background:rgba(0,0,0,.72);color:#fff;font-family:Montserrat,sans-serif;font-size:9px;font-weight:800;letter-spacing:.12em}
  .amenity-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .amenity-chips span{padding:8px 12px;border:1px solid #ddd;background:#fff;font-size:11px;font-weight:700}
  .price-stack{display:grid;gap:18px;margin-top:30px}
  .price-card{position:relative;padding:28px 22px;background:#fff;color:#171717;border:2px solid transparent}
  .price-card.popular{border-color:#f16e32}
  .popular-tag{position:absolute;top:-12px;right:12px;padding:4px 11px;background:#f16e32;color:#fff;font-size:10px;font-weight:900}
  .price-card h3{margin:0;font-family:Montserrat,sans-serif;font-size:24px}
  .price-for{min-height:42px;margin:5px 0 16px;color:#666;font-size:11px}
  .price-value{margin-bottom:18px;color:#f16e32;font-family:Montserrat,sans-serif;font-size:38px;font-weight:900;line-height:1}
  .price-value small{color:#555;font-size:11px}
  .price-card ul{margin:0;padding:0;list-style:none}
  .price-card li{padding:8px 0;border-top:1px solid #eee;font-size:12px}
  .price-card li::before{content:"✓";margin-right:8px;color:#f16e32;font-weight:900}
  .ticket-table{margin-top:30px;background:#fff;color:#171717}
  .ticket-table h3{margin:0;padding:20px;background:#f16e32;color:#fff;text-align:center}
  .ticket-row{display:grid;grid-template-columns:70px 1fr 1fr;align-items:center;padding:13px 16px;border-bottom:1px solid #eee;font-size:12px}
  .ticket-row strong{font-family:Montserrat,sans-serif;font-size:18px}
  .price-note{margin:16px 0 0;color:#aaa;font-size:10px}
  .trainer-card{margin-top:28px;background:#fff;color:#171717}
  .trainer-card img{height:410px;object-fit:cover;object-position:center 24%}
  .trainer-body{padding:25px 21px}
  .trainer-role{color:#f16e32;font-size:11px;font-weight:900}
  .trainer-body h3{margin:4px 0 12px;font-size:25px}
  .trainer-body p{margin:0;color:#5f5f5f;font-size:13px}
  .trainer-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
  .trainer-tags span{padding:5px 8px;background:#f1f1f1;font-size:10px;font-weight:700}
  .flow-list{position:relative;display:grid;gap:11px;margin-top:32px}
  .flow-item{display:grid;grid-template-columns:58px 1fr;gap:15px;padding:20px;background:#fff;border-left:4px solid #f16e32}
  .flow-number{color:#f16e32;font-family:Montserrat,sans-serif;font-size:25px;font-weight:900}
  .flow-item h3{margin:0 0 4px;font-size:16px}
  .flow-item p{margin:0;color:#666;font-size:11px}
  .faq-list{margin-top:28px;border-top:1px solid #333}
  .faq-item{border-bottom:1px solid #333}
  .faq-question{display:grid;grid-template-columns:32px 1fr 24px;align-items:center;width:100%;padding:19px 0;border:0;background:transparent;color:#fff;text-align:left;cursor:pointer;font-weight:700}
  .faq-question strong{color:#f16e32;font-family:Montserrat,sans-serif;font-size:20px}
  .faq-question i{font-style:normal;font-size:20px;transition:.2s}
  .faq-answer{display:none;padding:0 0 20px 32px;color:#bbb;font-size:12px}
  .faq-item.open .faq-answer{display:block}
  .faq-item.open .faq-question i{transform:rotate(45deg)}
  .access-map{height:320px;margin-top:24px;border:0;background:#eee}
  .access-map iframe{width:100%;height:100%;border:0}
  .access-table{margin-top:20px}
  .access-row{display:grid;grid-template-columns:92px 1fr;padding:14px 0;border-bottom:1px solid #ddd;font-size:12px}
  .access-row dt{font-weight:900}
  .access-row dd{margin:0}
  .final-cta{position:relative;padding:75px 24px 110px;background:linear-gradient(rgba(0,0,0,.72),rgba(0,0,0,.82)),url("/images/gym.jpg") center/cover;color:#fff;text-align:center}
  .final-cta h2{margin:0 0 10px;font-size:30px;line-height:1.5}
  .final-cta p{margin:0 0 22px;color:#ddd;font-size:13px}
  .final-actions{display:grid;gap:10px}
  .studio-footer{padding:38px 22px 105px;background:#101010;color:#aaa;text-align:center}
  .studio-footer img{width:190px;margin:0 auto 24px;filter:brightness(0) invert(1)}
  .footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;margin-bottom:22px}
  .footer-links a{font-size:10px;text-decoration:underline}
  .studio-footer p{margin:6px 0;font-size:10px}
  .sticky-cta{position:fixed;z-index:45;bottom:0;left:50%;display:grid;grid-template-columns:1fr 1.25fr;width:min(620px,100%);transform:translateX(-50%);box-shadow:0 -5px 18px rgba(0,0,0,.17)}
  .sticky-cta a{display:grid;place-items:center;min-height:67px;color:#fff;font-size:12px;font-weight:900;text-align:center}
  .sticky-cta .sticky-line{background:#06c755}
  .sticky-cta .sticky-book{background:#f16e32}
  .sticky-cta small{display:block;font-size:8px;font-weight:600}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media (max-width:480px){
    .studio-header{height:62px}
    .studio-logo{width:auto;padding:0 10px}
    .studio-logo img{width:112px}
    .header-action{min-width:55px;padding:6px;font-size:8px}
    .header-action strong{font-size:12px}
    .menu-button{width:46px}
    .studio-nav{top:62px;max-height:calc(100vh - 62px)}
    .hero-studio,.hero-inner{min-height:665px}
    .hero-inner{padding:32px 20px 34px}
    .hero-studio h1{font-size:30px;letter-spacing:.01em}
    .hero-lead{font-size:13px}
    .campaign-card{margin-left:12px;margin-right:12px}
    .section{padding:62px 20px}
    .section-title{font-size:26px}
    .feature-photo{height:220px}
    .trainer-card img{height:330px}
    .sticky-cta a{min-height:61px}
  }
</style>
