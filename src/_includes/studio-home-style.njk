<style>
  *,*::before,*::after{box-sizing:border-box}
  html{max-width:100%;overflow-x:hidden;scroll-behavior:smooth}
  body{max-width:100%;margin:0;overflow-x:hidden;background:#fff;color:#272727;font-family:"Noto Sans JP",sans-serif;line-height:1.72;-webkit-font-smoothing:antialiased}
  body.menu-open{overflow:hidden}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  button{font:inherit}
  :root{--orange:#f35319;--orange2:#e92315;--dark:#272727;--beige:#fef9f2;--gray:#e6e6e6;--green:#47c82b;--yellow:#fff000}
  .studio-page{position:relative;width:100%;margin:0;background:#fff}
  .studio-header{position:sticky;z-index:50;top:0;height:64px;border-bottom:1px solid #ece7e2;background:rgba(255,255,255,.97);box-shadow:0 6px 24px rgba(24,20,17,.05);backdrop-filter:blur(12px)}
  .studio-header-inner{display:flex;align-items:center;justify-content:space-between;height:100%;padding:0 16px}
  .studio-brand{display:flex;min-width:0;flex-direction:column;justify-content:center}
  .studio-brand small{font-size:6px;font-weight:900;line-height:1.2;white-space:nowrap}
  .studio-brand img{width:116px;margin-top:3px}
  .desktop-nav,.desktop-actions{display:none}
  .menu-toggle{display:grid;width:48px;height:52px;padding:8px 10px 5px;border:0;background:transparent;cursor:pointer}
  .menu-toggle span{display:block;width:26px;height:2px;margin:auto;background:#272727;transition:transform .25s,opacity .25s}
  .menu-toggle small{font-size:8px;font-weight:900;letter-spacing:.08em;line-height:1}
  .menu-open .menu-toggle span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .menu-open .menu-toggle span:nth-child(2){opacity:0}
  .menu-open .menu-toggle span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .mobile-menu{position:fixed;z-index:52;top:64px;right:0;bottom:auto;width:min(88vw,380px);height:calc(100dvh - 64px);padding:24px;background:#fff;box-shadow:-16px 20px 40px rgba(0,0,0,.16);transform:translateX(105%);transition:transform .28s ease;overflow-y:auto}
  .menu-open .mobile-menu{transform:translateX(0)}
  .mobile-menu-links{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #ded8d1}
  .mobile-menu-links a{padding:15px 8px;border-bottom:1px solid #ded8d1;font-size:13px;font-weight:800}
  .mobile-menu-actions{display:grid;gap:10px;margin-top:24px}
  .mobile-menu-actions a{padding:14px;border-radius:4px;color:#fff;font-weight:900;text-align:center}
  .mobile-menu-actions .line{background:#16b83e}
  .mobile-menu-actions .book{background:linear-gradient(110deg,#f36d24,#e9361f)}
  .menu-scrim{position:fixed;z-index:51;inset:64px 0 0;display:block;width:100%;border:0;background:rgba(0,0,0,.48);opacity:0;pointer-events:none;transition:opacity .25s}
  .menu-open .menu-scrim{opacity:1;pointer-events:auto}
  .studio-responsive-hero{position:relative;min-height:700px;overflow:hidden;background:#050505;color:#fff}
  .studio-hero-photo{position:absolute;top:91px;right:0;left:0;height:365px;overflow:hidden}
  .studio-hero-photo img{width:100%;height:100%;object-fit:cover;object-position:69% center}
  .studio-hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 28%,rgba(5,5,5,.12) 42%,rgba(5,5,5,.95) 67%,#050505 82%)}
  .studio-hero-content{position:relative;z-index:1;display:flex;min-height:700px;flex-direction:column}
  .studio-hero-promise{margin:0;padding:13px 15px 16px;background:linear-gradient(110deg,#ff913d 0%,#ef4028 100%);font-size:clamp(19px,5.4vw,25px);font-weight:900;line-height:1.45;letter-spacing:-.02em;text-shadow:0 2px 4px rgba(0,0,0,.14)}
  .studio-hero-promise span{display:block;white-space:nowrap}
  .studio-hero-promise span:first-child::after{content:" →";font-family:"DM Sans",sans-serif}
  .studio-hero-main{margin-top:auto;padding:0 16px 14px;text-align:center}
  .studio-hero-programs{display:grid;grid-template-columns:1fr 34px 1fr;align-items:center;max-width:360px;margin:0 auto 12px}
  .studio-hero-programs>div{padding:8px 7px 10px;background:linear-gradient(135deg,#ff6d43,#e93b29);clip-path:polygon(7% 0,100% 0,93% 100%,0 100%);filter:drop-shadow(0 4px 6px rgba(0,0,0,.2))}
  .studio-hero-programs small,.studio-hero-programs strong{display:block;font-weight:900;line-height:1.05}
  .studio-hero-programs small{font-size:16px}
  .studio-hero-programs strong{font-size:25px}
  .studio-hero-programs>b{font-size:31px;font-weight:400}
  .studio-hero-main h1{margin:0;font-style:normal;font-weight:900;line-height:1.08;text-shadow:0 3px 8px rgba(0,0,0,.65)}
  .studio-hero-main h1 span,.studio-hero-main h1 strong,.studio-hero-main h1 em{display:block;font-style:normal}
  .studio-hero-main h1 span{color:#fff320;font-size:29px}
  .studio-hero-main h1 strong{color:#fff320;font-size:42px}
  .studio-hero-main h1 em{display:flex;align-items:center;justify-content:center;gap:.22em;font-size:29px}
  .studio-hero-main h1 em i{position:relative;display:inline-block;width:.82em;height:.56em;flex:0 0 .82em;color:transparent;font-size:1em;font-style:normal;line-height:0}
  .studio-hero-main h1 em i::before,.studio-hero-main h1 em i::after{content:"";position:absolute;left:0;width:100%;height:.11em;border-radius:2px;background:#fff;box-shadow:0 2px 5px rgba(0,0,0,.35)}
  .studio-hero-main h1 em i::before{top:.11em}
  .studio-hero-main h1 em i::after{bottom:.1em}
  .studio-hero-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;padding:0 10px 14px;background:#050505;text-align:center}
  .studio-hero-proof>div{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:0;aspect-ratio:1;padding:9px 4px;border:2px solid rgba(255,255,255,.75);border-radius:50%;background:linear-gradient(145deg,#fb8a44,#e5482f);box-shadow:inset 0 0 0 3px rgba(255,255,255,.18),0 6px 13px rgba(0,0,0,.2);line-height:1.15}
  .studio-proof-icon{width:25px;height:25px;margin-bottom:2px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .studio-hero-proof p{margin:3px 0 2px;font-size:8px;font-weight:800;line-height:1.2}
  .studio-hero-proof strong{font-size:12px;font-weight:900;line-height:1.05}
  .studio-hero-proof small{margin-top:3px;font-size:9px;font-weight:800;line-height:1.1}
  .studio-hero-price{display:grid!important;grid-template-columns:auto auto;grid-template-rows:auto auto;align-items:center;justify-content:center;column-gap:2px;line-height:1!important}
  .studio-hero-price .studio-price-label{grid-row:1/3;font:900 7px/1.05 "Noto Sans JP",sans-serif;letter-spacing:0}
  .studio-price-main{display:flex;grid-column:2;grid-row:1;align-items:baseline;justify-content:center;white-space:nowrap}
  .studio-hero-price em{font-size:18px;font-style:normal}
  .studio-hero-price b{margin-left:1px;font-size:13px}
  .studio-hero-price .studio-price-unit{grid-column:2;grid-row:2;justify-self:center;font:900 9px/1 "Noto Sans JP",sans-serif;letter-spacing:0}
  .campaign-mini{position:relative;overflow:hidden;padding:28px 15px 48px;background:linear-gradient(110deg,#ff741c 0%,#ee1c18 100%);color:#fff;text-align:center}
  .campaign-mini::after{content:"";position:absolute;right:-4%;bottom:-1px;left:-4%;height:30px;background:#fff;clip-path:polygon(0 72%,52% 12%,100% 72%,100% 100%,0 100%)}
  .campaign-mini-ribbon{max-width:780px;margin:0 auto 18px;padding:8px 18px;border:3px solid #fff;background:#3a3d40;font-size:20px;font-weight:900;line-height:1.25;transform:skew(-12deg)}
  .campaign-mini-ribbon span{display:block;transform:skew(12deg)}
  .campaign-mini>h2{margin:0 0 19px;color:#fff000;font-size:clamp(25px,7vw,36px);font-weight:900;line-height:1.25}
  .campaign-mini-panel{max-width:980px;margin:0 auto;padding:17px 15px 13px;background:#fff;color:#272727}
  .campaign-mini-row{display:grid;gap:12px;align-items:center}
  .campaign-mini-status{margin:0;font-size:15px;font-weight:900}
  .campaign-mini-status strong{color:#e94a48}
  .campaign-mini-status b{font-size:1.12em}
  .campaign-mini-button{display:grid;width:100%;max-width:640px;grid-template-columns:72px minmax(0,1fr) 42px;align-items:center;min-height:76px;margin:0 auto;overflow:hidden;border:4px solid #fff;border-radius:999px;background:#06bf00;color:#fff;box-shadow:0 3px 10px rgba(0,0,0,.3);font-weight:900}
  .campaign-mini-hand{display:grid;place-items:center;align-self:stretch;border-right:3px solid #fff;font-size:14px;line-height:1.05}
  .campaign-mini-hand strong{font-size:23px}
  .campaign-mini-button-copy{font-size:25px;line-height:1.08}
  .campaign-mini-button-copy strong{display:block;color:#fff000}
  .campaign-mini-button>b{font-size:36px;font-weight:500}
  .campaign-mini-note{margin:10px 0 0;color:#555;font-size:9px}
  .campaign-full .campaign-ribbon{margin:-4px auto 8px;padding:6px 14px;border:3px solid #fff;background:#3a3d40;color:#fff;font-size:18px;font-weight:900;transform:skew(-12deg)}
  .campaign-ribbon span{display:block;transform:skew(12deg)}
  .campaign-full h2{margin:5px 0 11px;color:#fff000;font-size:28px;line-height:1.3}
  .trial-box{padding:12px 16px;background:#fff;color:#333}
  .trial-box p{margin:0 0 7px;font-size:13px;font-weight:800}
  .trial-box p strong{color:#d44840}
  .trial-button{display:flex;align-items:center;justify-content:center;gap:12px;max-width:330px;margin:auto;padding:8px 16px;border-radius:40px;background:#49b92c;color:#fff;box-shadow:0 2px 6px rgba(0,0,0,.25);font-size:25px;font-weight:900;line-height:1.1}
  .trial-button small{display:grid;place-items:center;width:60px;height:60px;border:2px solid #fff;border-radius:50%;font-size:17px}
  .trial-button::after{content:"→";font-size:30px}
  .trial-note{margin:7px 0 0!important;color:#555!important;font-size:9px!important;font-weight:400!important}
  .section{position:relative;padding:64px 23px}
  .section-gray{background:#e6e6e6}
  .section-beige{background:#fef9f2}
  .section-dark{background:#272727;color:#fff}
  .section-price{background:#f5f6f9}
  .ghost{position:absolute;top:4px;left:0;right:0;color:rgba(39,39,39,.07);font-size:58px;font-weight:900;line-height:1;text-align:center}
  .section-dark .ghost{color:rgba(255,255,255,.08)}
  .eyebrow{position:relative;margin:0 0 8px;color:#e75000;font-size:16px;font-weight:900;text-align:center;letter-spacing:.08em}
  .section-title{position:relative;margin:0 0 25px;font-size:32px;font-weight:900;line-height:1.45;text-align:center}
  .section-title .orange{color:#e75000}
  .section-title .yellow{color:#fff000}
  .lead{text-align:center;font-weight:700}
  .hybrid-intro{padding:42px 24px 54px;background:#fff;text-align:center}
  .hybrid-intro h2{margin:0 0 18px;font-size:31px;line-height:1.5}
  .hybrid-intro h2 .hot{color:#e64e49}
  .hybrid-points{margin-top:24px;padding:9px 14px;border:2px solid #272727;text-align:left}
  .hybrid-point{display:grid;grid-template-columns:32px 1fr;gap:10px;padding:11px 0;border-bottom:1px dashed #555;font-size:14px}
  .hybrid-point:last-child{border-bottom:0}
  .hybrid-point img{width:30px}
  .hybrid-point b{font-weight:900}
  .worry-title{margin:0 0 28px;font-size:34px;line-height:1.35;text-align:center}
  .worry-title .red{color:#e64e49}
  .worry-scene{position:relative;margin:0 -23px 26px}
  .worry-scene img{width:calc(100% - 78px);height:302px;object-fit:cover}
  .worry-scene.right img{margin-left:auto}
  .worry-tag{position:absolute;padding:7px 10px;background:#fff;font-size:15px;font-weight:900;box-shadow:0 2px 10px rgba(0,0,0,.05)}
  .worry-tag b{color:#e64e49}
  .worry-scene .tag1{right:16px;top:12px}
  .worry-scene .tag2{right:8px;top:63px}
  .worry-scene .tag3{left:8px;top:8px}
  .worry-scene .tag4{left:30px;top:176px}
  .worry-scene .tag5{right:12px;bottom:13px}
  .worry-copy{font-size:14px;text-align:center}
  .solution{padding:55px 28px 0;background:#fef9f2;text-align:center}
  .solution h2{font-size:30px;line-height:1.65}
  .solution .under{border-bottom:4px solid #f35319}
  .solution p{font-size:19px;font-weight:900}
  .solution-dark{margin:35px -28px 0;padding:28px 20px;background:#272727;color:#fff}
  .solution-dark b{display:block;font-size:28px}
  .solution-dark .yellow{color:#fff000}
  .solution-body{padding:34px 3px 56px;font-size:18px;font-weight:800}
  .feature-list{display:grid;gap:24px}
  .feature-card{position:relative;padding:14px;background:#fff;box-shadow:0 6px 14px rgba(0,0,0,.14)}
  .feature-no{position:absolute;left:0;top:0;z-index:2;padding:4px 13px;background:#272727;color:#fff;font-size:29px;font-weight:900}
  .feature-card img{width:100%;height:259px;object-fit:cover}
  .feature-card h3{margin:15px 0 12px;font-size:20px;line-height:1.4;text-align:center}
  .feature-card p{margin:0;font-size:13px}
  .voice-proof{padding-bottom:0}
  .review-collage{width:488px;margin:0 -7px}
  .future-call{position:relative;overflow:hidden;padding:86px 25px 48px;background:#fff;text-align:center}
  .future-call::before{content:"";position:absolute;left:0;right:0;top:0;height:66px;background:#272727;clip-path:polygon(0 0,100% 0,50% 100%)}
  .future-call-copy{position:relative;max-width:680px;margin:0 auto}
  .future-call h3{position:relative;margin:0;font-size:27px;line-height:1.48}
  .future-call h3::before,.future-call h3::after{position:absolute;color:#ebebeb;font:900 76px/.7 Georgia,serif}
  .future-call h3::before{content:"“";left:0;top:-5px}
  .future-call h3::after{content:"”";right:0;bottom:-25px}
  .future-call p{margin:24px 0 0;font-size:15px;font-weight:800;line-height:1.65;letter-spacing:.06em}
  .campaign-full{padding:20px 15px 29px;background:linear-gradient(110deg,#fd7b1d 0%,#e92315 100%);text-align:center}
  .campaign-full .campaign-ribbon{width:100%;font-size:17px}
  .benefit{position:relative;margin:17px 0;padding:22px 14px;background:#fff}
  .benefit-label{position:absolute;left:13px;top:-9px;padding:4px 8px;background:#ffd239;color:#111;font-weight:900}
  .benefit h3{margin:0 0 8px;font-size:22px}
  .benefit-deal{font-size:21px;font-weight:900}
  .benefit-deal s{font-size:17px}
  .benefit-deal strong{display:block;margin-top:4px;color:#e75000;font-size:52px;line-height:1.15;white-space:nowrap}
  .guide-grid{display:grid;grid-template-columns:150px 1fr;gap:12px;align-items:center}
  .guide-grid img{width:150px}
  .guide-grid h3{font-size:17px}
  .guide-list{margin:0;padding:0;list-style:none;font-size:12px;text-align:left}
  .guide-list li{margin:5px 0}
  .reason-list{display:grid;gap:28px}
  .reason-heading{display:grid;grid-template-columns:64px minmax(0,1fr);align-items:center;gap:10px}
  .reason-card h3{margin:0;font-size:18px;line-height:1.45}
  .reason-no{display:block;color:#e64e49;font-size:54px;font-weight:900;line-height:1}
  .reason-card img{width:100%;margin:10px 0}
  .reason-card p{margin:0;font-size:13px;line-height:1.8}
  .continue-rate{position:relative;display:grid;justify-items:center;gap:18px;margin:52px auto 42px;padding:30px 18px 38px;border-top:5px solid #ec514e;background:#fff;box-shadow:0 14px 30px rgba(104,67,52,.11);text-align:center}
  .continue-rate::after{content:"";position:absolute;right:0;bottom:-26px;left:0;height:27px;background:#fff;clip-path:polygon(0 0,100% 0,50% 100%)}
  .continue-rate-chart{position:relative;display:grid;width:164px;aspect-ratio:1;place-items:center;border-radius:50%;background:conic-gradient(#ec514e 0 342deg,#f6e5dc 342deg 360deg);box-shadow:0 9px 22px rgba(236,81,78,.2)}
  .continue-rate-chart::before{content:"";position:absolute;width:70%;aspect-ratio:1;border-radius:50%;background:#fff}
  .continue-rate-chart strong{position:relative;color:#ec514e;font:900 62px/1 "DM Sans",sans-serif;letter-spacing:-.06em}
  .continue-rate-chart strong small{font-size:.48em;letter-spacing:0}
  .continue-rate-copy>span{display:inline-block;padding:5px 11px;background:#272727;color:#fff;font:800 9px/1 "DM Sans",sans-serif;letter-spacing:.14em}
  .continue-rate-copy p{margin:10px 0 0}
  .continue-rate-copy p small{display:block;font-size:13px;font-weight:800}
  .continue-rate-copy p strong{display:block;margin-top:4px;color:#272727;font-size:25px;line-height:1.45}
  .science-box{padding:28px 16px;background:#fff}
  .science-box h3{font-size:24px;text-align:center}
  .science-list{display:grid;gap:10px;margin-top:20px}
  .science-list div{padding:14px;border:2px solid #272727;font-size:13px}
  .ba-section{padding-left:0;padding-right:0}
  .ba-section .section-title{padding:0 20px}
  .ba-note{padding:0 15px;font-size:9px}
  .ba-list{display:grid;gap:10px}
  .ba-list img{width:520px}
  .studio-results-lead,.studio-gallery-lead{margin:-8px auto 28px;text-align:center;font-size:13px}
  .studio-results-carousel{position:relative;margin:0 auto}
  .studio-results-viewport{overflow:hidden;border-radius:5px;box-shadow:0 14px 32px rgba(0,0,0,.15)}
  .studio-results-track{display:flex;transition:transform .45s cubic-bezier(.4,0,.2,1)}
  .studio-result-slide{display:grid;min-width:100%;background:#272727;color:#fff}
  .studio-result-photo{display:flex;align-items:center;justify-content:center;min-height:260px;background:#151515}
  .studio-result-photo img{width:100%;height:100%;max-height:390px;object-fit:contain}
  .studio-result-copy{padding:27px 22px 30px}
  .studio-result-tag{color:#ff8b4b;font:700 10px/1 "DM Sans",sans-serif;letter-spacing:.12em}
  .studio-result-number{margin-top:13px;font:900 58px/1 "DM Sans",sans-serif}
  .studio-result-number em{margin-left:3px;color:#ff7a3d;font-size:30px;font-style:normal}
  .studio-result-label{margin:8px 0 0;font-size:12px;font-weight:800}
  .studio-result-meta{margin:7px 0 18px;color:#bcbcbc;font-size:10px;letter-spacing:.05em}
  .studio-result-copy blockquote{margin:0;padding:15px 0;border-top:1px solid #555;border-bottom:1px solid #555;font-size:12px;line-height:1.9}
  .studio-result-who{margin:12px 0 0;color:#bcbcbc;font-size:10px}
  .studio-results-arrow{position:absolute;z-index:3;top:50%;display:grid;place-items:center;width:42px;height:42px;padding:0;border:1px solid #ddd;border-radius:50%;background:#fff;color:#272727;box-shadow:0 4px 16px rgba(0,0,0,.17);font-size:26px;line-height:1;transform:translateY(-50%);cursor:pointer}
  .studio-results-arrow.prev{left:-12px}
  .studio-results-arrow.next{right:-12px}
  .studio-results-dots{display:flex;justify-content:center;gap:8px;margin:22px 0 12px}
  .studio-results-dots button{width:9px;height:9px;padding:0;border:0;border-radius:50%;background:#c9c1b8;cursor:pointer}
  .studio-results-dots button.active{background:#e75000;transform:scale(1.2)}
  .customer-reviews{padding:60px 16px;background:#393d41;color:#fff}
  .customer-card{margin:23px 0 42px;background:#fff;color:#333}
  .customer-head{display:grid;grid-template-columns:95px 1fr;gap:14px;align-items:center;padding:13px;background:#ef5c21;color:#fff}
  .customer-person{text-align:center;font-weight:900}
  .customer-person img{width:61px;margin:0 auto 4px}
  .customer-head b{font-size:14px}
  .customer-body{padding:18px;font-size:13px}
  .customer-body strong{color:#e75000}
  .customer-sign{width:160px;margin:15px auto 0}
  .secrets{overflow:hidden;padding-right:0;padding-left:0}
  .secrets>.section-title{margin-bottom:78px;padding:0 22px}
  .secrets-title-lead{display:block}
  .secret-card{--secret-bg:#e7e4e4;position:relative;display:grid;margin:0;padding:52px 22px 64px;background:var(--secret-bg);text-align:center}
  .secret-card::before{content:"";position:absolute;top:-47px;right:0;left:0;height:48px;background:var(--secret-bg)}
  .secret-slope-right::before{clip-path:polygon(0 100%,100% 0,100% 100%)}
  .secret-slope-left::before{clip-path:polygon(0 0,100% 100%,0 100%)}
  .secret-white{--secret-bg:#fff}
  .secret-gray{--secret-bg:#e7e4e4}
  .secret-card+.secret-card{margin-top:47px}
  .secret-label{display:inline-block;padding:5px 24px;background:#000;color:#fff;font-size:18px;font-weight:900;transform:skew(-14deg)}
  .secret-card h3{margin:18px 0 22px;color:#e75000;font-size:24px;line-height:1.45}
  .secret-card img{width:100%;max-width:474px;height:245px;margin:0 auto;object-fit:cover}
  .check-list{margin:18px 0 0;padding:0;list-style:none;text-align:left}
  .check-list li{margin:12px 0;padding-left:20px;font-size:14px}
