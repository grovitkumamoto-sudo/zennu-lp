<style>
  *,*::before,*::after{box-sizing:border-box}
  html{max-width:100%;overflow-x:hidden;scroll-behavior:smooth}
  body{max-width:100%;margin:0;overflow-x:hidden;background:#fff;color:#272727;font-family:"Noto Sans JP",sans-serif;line-height:1.72;-webkit-font-smoothing:antialiased}
  body.menu-open{overflow:hidden}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  button{font:inherit}
  :root{--orange:#f35319;--orange2:#e92315;--dark:#272727;--beige:#fef9f2;--gray:#e6e6e6;--green:#47c82b;--yellow:#fff000}
  .studio-page{position:relative;width:100%;margin:0;background:#fff}
  .studio-header{position:sticky;z-index:50;top:0;height:64px;border-bottom:1px solid #ece7e2;background:rgba(255,255,255,.97);box-shadow:0 6px 24px rgba(24,20,17,.05);backdrop-filter:blur(12px)}
  .studio-header-inner{display:flex;align-items:center;justify-content:space-between;height:100%;padding:0 16px}
  .studio-brand{display:flex;min-width:0;flex-direction:column;justify-content:center}
  .studio-brand small{font-size:6px;font-weight:900;line-height:1.2;white-space:nowrap}
  .studio-brand img{width:116px;margin-top:3px}
  .desktop-nav,.desktop-actions{display:none}
  .menu-toggle{display:grid;width:48px;height:52px;padding:8px 10px 5px;border:0;background:transparent;cursor:pointer}
  .menu-toggle span{display:block;width:26px;height:2px;margin:auto;background:#272727;transition:transform .25s,opacity .25s}
  .menu-toggle small{font-size:8px;font-weight:900;letter-spacing:.08em;line-height:1}
  .menu-open .menu-toggle span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .menu-open .menu-toggle span:nth-child(2){opacity:0}
  .menu-open .menu-toggle span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .mobile-menu{position:fixed;z-index:52;top:64px;right:0;bottom:0;width:min(88vw,380px);padding:24px;background:#fff;box-shadow:-16px 20px 40px rgba(0,0,0,.16);transform:translateX(105%);transition:transform .28s ease;overflow-y:auto}
  .menu-open .mobile-menu{transform:translateX(0)}
  .mobile-menu-links{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #ded8d1}
  .mobile-menu-links a{padding:15px 8px;border-bottom:1px solid #ded8d1;font-size:13px;font-weight:800}
  .mobile-menu-actions{display:grid;gap:10px;margin-top:24px}
  .mobile-menu-actions a{padding:14px;border-radius:4px;color:#fff;font-weight:900;text-align:center}
  .mobile-menu-actions .line{background:#16b83e}
  .mobile-menu-actions .book{background:linear-gradient(110deg,#f36d24,#e9361f)}
  .menu-scrim{position:fixed;z-index:51;inset:64px 0 0;display:block;width:100%;border:0;background:rgba(0,0,0,.48);opacity:0;pointer-events:none;transition:opacity .25s}
  .menu-open .menu-scrim{opacity:1;pointer-events:auto}
  .html-hero{position:relative;overflow:hidden;background:#0d0e0f;color:#fff}
  .html-hero-inner{display:flex;flex-direction:column}
  .html-hero-copy{order:2;padding:34px 20px 30px;background:linear-gradient(145deg,#101112 0%,#242321 100%)}
  .html-hero-kicker{margin:0 0 13px;color:#f58d4a;font:700 10px/1 "DM Sans",sans-serif;letter-spacing:.18em}
  .html-hero-tagline{display:block}
  .html-hero-tagline h1{margin:0;color:#fff;font-size:clamp(30px,8.4vw,42px);font-weight:900;line-height:1.18;letter-spacing:-.035em}
  .html-hero-tagline h1 span{display:block}
  .html-hero-programs{display:grid;grid-template-columns:1fr 38px 1fr;align-items:center;margin:25px 0 18px;color:#fff;text-align:center}
  .html-hero-programs>div{padding:9px 6px 11px;border:1px solid rgba(255,255,255,.24);border-radius:4px;background:rgba(255,255,255,.07)}
  .html-hero-programs small,.html-hero-programs strong{display:block;font-weight:900;line-height:1.08}
  .html-hero-programs small{color:#f0b190;font-size:11px}
  .html-hero-programs strong{margin-top:3px;font-size:17px}
  .html-hero-times{font-size:26px;font-weight:400}
  .html-hero-message{padding:16px 0;border-top:1px solid rgba(255,255,255,.18);text-align:left}
  .html-hero-message p,.html-hero-message strong,.html-hero-message span{display:block;margin:0;font-weight:900;line-height:1.12}
  .html-hero-message p{color:#ffbf93;font-size:18px}
  .html-hero-message strong{color:#fff;font-size:33px}
  .html-hero-message span{margin-top:4px;color:#fff;font-size:21px}
  .html-hero-proof{display:grid;gap:8px}
  .html-hero-proof>div{display:grid;grid-template-columns:34px 1fr;align-items:center;padding:10px 12px;border:1px solid rgba(255,255,255,.18);border-radius:4px;background:rgba(255,255,255,.06)}
  .html-hero-proof span{grid-row:1/3;color:#f58d4a;font:700 17px/1 "DM Sans",sans-serif}
  .html-hero-proof b{font-size:10px;line-height:1.25}
  .html-hero-proof strong{font-size:12px;font-weight:900;line-height:1.25}
  .html-hero-proof em{font-size:1.65em;font-style:normal;line-height:.9}
  .html-hero-photo{position:relative;order:1;height:54vw;min-height:240px;max-height:400px;overflow:hidden}
  .html-hero-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 64%,rgba(0,0,0,.38))}
  .html-hero-photo img{width:100%;height:100%;object-fit:cover;object-position:63% 43%}
  .hero-photo-caption{position:absolute;z-index:1;right:15px;bottom:12px;color:#fff;font:700 9px/1 "DM Sans",sans-serif;letter-spacing:.14em}
  .campaign-mini{padding:0 20px 24px;background:#0d0e0f;color:#fff}
  .campaign-mini-inner{display:grid;gap:14px;padding:22px 18px;border-top:3px solid #f46b24;background:#fff;color:#272727;box-shadow:0 10px 32px rgba(0,0,0,.16)}
  .campaign-mini-copy>span{color:#e8501d;font-size:11px;font-weight:900;letter-spacing:.08em}
  .campaign-mini .campaign-mini-copy h2{margin:4px 0 2px;color:#272727;font-size:24px;line-height:1.2;text-align:left}
  .campaign-mini-copy h2 strong{color:#e8501d;font-size:1.45em}
  .campaign-mini-copy p{margin:0;color:#6b625b;font-size:11px}
  .campaign-mini-status{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#f8f2ec}
  .campaign-mini-status small{font-size:10px;font-weight:800}
  .campaign-mini-status p{margin:0;font-size:13px;font-weight:900}
  .campaign-mini-status strong{color:#e8501d;font-size:28px}
  .campaign-mini-button{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:62px;border-radius:4px;background:linear-gradient(110deg,#f36d24,#e9361f);color:#fff;box-shadow:0 5px 14px rgba(211,59,27,.24);font-size:17px;font-weight:900;line-height:1.25}
  .campaign-mini-button span{font-size:9px;letter-spacing:.08em}
  .campaign-mini .campaign-ribbon,.campaign-full .campaign-ribbon{margin:-4px auto 8px;padding:6px 14px;border:3px solid #fff;background:#3a3d40;color:#fff;font-size:18px;font-weight:900;transform:skew(-12deg)}
  .campaign-ribbon span{display:block;transform:skew(12deg)}
  .campaign-mini h2,.campaign-full h2{margin:5px 0 11px;color:#fff000;font-size:28px;line-height:1.3}
  .trial-box{padding:12px 16px;background:#fff;color:#333}
  .trial-box p{margin:0 0 7px;font-size:13px;font-weight:800}
  .trial-box p strong{color:#d44840}
  .trial-button{display:flex;align-items:center;justify-content:center;gap:12px;max-width:330px;margin:auto;padding:8px 16px;border-radius:40px;background:#49b92c;color:#fff;box-shadow:0 2px 6px rgba(0,0,0,.25);font-size:25px;font-weight:900;line-height:1.1}
  .trial-button small{display:grid;place-items:center;width:60px;height:60px;border:2px solid #fff;border-radius:50%;font-size:17px}
  .trial-button::after{content:"→";font-size:30px}
  .trial-note{margin:7px 0 0!important;color:#555!important;font-size:9px!important;font-weight:400!important}
