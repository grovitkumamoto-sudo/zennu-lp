  {% macro campaign(anchor) %}
  <section{% if anchor %} id="{{ anchor }}"{% endif %} class="campaign-full">
    <div class="campaign-ribbon"><span>初回限定キャンペーン</span></div>
    <h2>パーソナル無料体験会</h2>
    <div class="benefit-grid">
      <div class="benefit">
        <span class="benefit-label">特典 01</span>
        <h3>当日入会で</h3>
        <div class="benefit-deal"><span>入会金 <s>11,000円</s></span><strong>0円</strong></div>
      </div>
      <div class="benefit">
        <span class="benefit-label">特典 02</span>
        <h3>パーソナルトレーニング1回</h3>
        <div class="benefit-deal"><span>通常単発 <s>9,000円</s></span><strong>初回無料</strong></div>
      </div>
      <div class="benefit">
        <span class="benefit-label">特典 03</span>
        <div class="guide-grid">
          <img src="/images/studio/b2ca3a775b4c1199.webp" alt="カラダ分析シートと個別ダイエットガイド">
          <div>
            <h3>もう自己流から卒業！<br>あなただけのダイエットガイドを無料プレゼント</h3>
            <ul class="guide-list">
              <li>✓ カラダ分析シート</li>
              <li>✓ 個別トレーニングプログラム</li>
              <li>✓ 3食白米OKの食事マニュアル</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="trial-box">
      <p><strong>先着順！</strong> 今月予約枠残り{{ site.campaign.remaining }}名様</p>
      <a class="trial-button" href="https://zennuwellnessdesign.hacomono.jp/reserve/schedule/1/1/?trial=true" target="_blank" rel="noopener"><small>手ぶら<br>OK</small>無料体験を<br>予約する</a>
      <p class="trial-note">※人気につき予約枠が埋まりやすいため、お早めにご予約ください。</p>
    </div>
  </section>
  {% endmacro %}

  <div class="studio-page">
    <header class="studio-header">
      <div class="studio-header-inner">
        <a class="studio-brand" href="#top">
          <small>熊本市中央区のパーソナル&amp;フィットネスジム</small>
          <img src="/images/studio/93fa018970b42e1a.webp" alt="ZenNu WELLNESS DESIGN">
        </a>
        <nav class="desktop-nav" aria-label="メインメニュー">
          <a href="#features">特徴</a>
          <a href="#reason">選ばれる理由</a>
          <a href="#before-after">実績</a>
          <a href="#gallery">館内</a>
          <a href="#price">料金</a>
          <a href="#trainer">トレーナー</a>
          <a href="#access">アクセス</a>
          <a href="#faq">FAQ</a>
          <a href="/blog/">ブログ</a>
        </nav>
        <div class="desktop-actions">
          <a class="header-line-link" href="{{ site.contact.lineUrl }}" target="_blank" rel="noopener" aria-label="LINEで相談">LINE</a>
          <a class="header-reserve" href="https://zennuwellnessdesign.hacomono.jp/reserve/schedule/1/1/?trial=true" target="_blank" rel="noopener"><span>初回体験</span>無料体験を予約</a>
        </div>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く">
          <span></span><span></span><span></span>
