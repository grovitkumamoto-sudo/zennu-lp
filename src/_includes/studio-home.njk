      <nav class="mobile-menu" id="mobile-menu" aria-label="スマートフォンメニュー" aria-hidden="true">
        <div class="mobile-menu-links">
          <a href="#features">特徴</a>
          <a href="#reason">選ばれる理由</a>
          <a href="#before-after">実績</a>
          <a href="#reviews">お客様の声</a>
          <a href="#gallery">館内ギャラリー</a>
          <a href="#price">料金</a>
          <a href="#trainer">トレーナー</a>
          <a href="#flow">体験の流れ</a>
          <a href="#access">アクセス</a>
          <a href="#faq">よくあるご質問</a>
          <a href="/blog/">ブログ・お知らせ</a>
