<script>
  // LINEボタンのリンク先を、LINE Harnessの計測用URL(/auth/line?ref=…)に差し替える。
  // どのページから友だち追加されたか(ref)と、流入元のUTM・広告クリックIDをLINE Harnessに記録するため。
  // 差し替え前のURL(microCMSのlineUrl)はJSが動かない場合のフォールバックとして残る。
  //   Googleビジネスプロフィール経由(utm_campaign=gbp)… meo_gbp
  //   広告LP(/cp1lp/ 等)… ad_lp_<LP名>  ／  それ以外のHP・ブログ … google_hp
  //   (SafariからのLINE追加ではutm_campaignがLINE Harnessに残らないため、MEOはrefで分ける)
  // refはLINE Harnessの流入経路(entry_routes)に登録済みのものと揃えること。
  (() => {
    const HARNESS = "https://line-harness.zennu-lineharness.workers.dev/auth/line";
    const LINE_HREF = /^https:\/\/(page\.line\.me|line\.me\/R\/ti\/p|lin\.ee)\//;
    const PASS_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid", "gclid"];

    // 下層ページに移ってもUTMを引き継げるよう、入口で付いていたものをセッション中だけ覚えておく
    const landing = (() => {
      const key = "zennu_landing_params";
      const current = new URLSearchParams(location.search);
      const found = PASS_PARAMS.filter(name => current.get(name)).map(name => [name, current.get(name)]);
      try {
        if (found.length) sessionStorage.setItem(key, JSON.stringify(found));
        return found.length ? found : JSON.parse(sessionStorage.getItem(key) || "[]");
      } catch {
        return found;
      }
    })();

    const lp = location.pathname.match(/^\/((cp|wg)\d+lp)\//);
    const fromGbp = landing.some(([name, value]) => name === "utm_campaign" && value === "gbp");
    const ref = fromGbp ? "meo_gbp" : lp ? `ad_lp_${lp[1]}` : "google_hp";

    const url = new URL(HARNESS);
    url.searchParams.set("ref", ref);
    landing.forEach(([name, value]) => url.searchParams.set(name, value));

    const rewrite = root => {
      (root.querySelectorAll ? root.querySelectorAll("a[href]") : []).forEach(link => {
        if (LINE_HREF.test(link.href)) link.href = url.toString();
      });
    };
    rewrite(document);
    new MutationObserver(records => records.forEach(record => record.addedNodes.forEach(node => {
      if (node.nodeType === Node.ELEMENT_NODE) rewrite(node.parentNode || node);
    }))).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
