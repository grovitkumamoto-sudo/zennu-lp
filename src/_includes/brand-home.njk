  <script>
    (() => {
      const button = document.querySelector('.brand-menu-button');
      const mobileNav = document.getElementById('brand-mobile-nav');
      const closeMenu = () => {
        document.body.classList.remove('brand-menu-open');
        button.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
      };
      button.addEventListener('click', () => {
        const open = !document.body.classList.contains('brand-menu-open');
        document.body.classList.toggle('brand-menu-open', open);
        button.setAttribute('aria-expanded', String(open));
        mobileNav.setAttribute('aria-hidden', String(!open));
      });
      mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.querySelectorAll('[data-cta]').forEach(link => link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({event:'cta_click',lp_variant:'main',cta_location:link.dataset.cta});
      }));
    })();
  </script>
