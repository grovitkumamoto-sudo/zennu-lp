  <link rel="preload" as="image" href="/images/studio-hero-original.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
  {% include "brand-home-style.njk" %}
  {% include "latest-blog-style.njk" %}
