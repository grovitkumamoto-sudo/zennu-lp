  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} | ZenNu WELLNESS DESIGN</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="{{ site.meta.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ZenNu WELLNESS DESIGN">
  <meta property="og:title" content="{{ title }} | ZenNu WELLNESS DESIGN">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.meta.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.meta.url }}{{ ogImage }}">
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {% if pageKey == "home" %}<link rel="preload" as="image" href="/images/hero.jpg">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  {% include "brand-home-style.njk" %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@graph":[{"@type":"HealthClub","@id":"{{ site.meta.url }}/#gym","name":"ZenNu WELLNESS DESIGN","description":"熊本市中央区・上通アーケード内のパーソナルジム。パーソナル、セルフ、両方の組み合わせから通い方を選べます。","url":"{{ site.meta.url }}/","image":"{{ site.meta.url }}/images/hero.jpg","telephone":"{{ site.contact.telDisplay }}","priceRange":"¥¥","address":{"@type":"PostalAddress","postalCode":"860-0845","addressRegion":"熊本県","addressLocality":"熊本市中央区","streetAddress":"上通町6-15 オークス第二ビル 2F","addressCountry":"JP"},"geo":{"@type":"GeoCoordinates","latitude":"{{ site.meta.lat }}","longitude":"{{ site.meta.lng }}"},"areaServed":[{"@type":"City","name":"熊本市"},{"@type":"Place","name":"上通"}],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"07:00","closes":"22:00"}]}{% if pageKey != "home" %},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"熊本市中央区・上通のパーソナルジム ZenNu","item":"{{ site.meta.url }}/"},{"@type":"ListItem","position":2,"name":"{{ title }}","item":"{{ site.meta.url }}{{ page.url }}"}]}{% endif %}]}
  </script>
  <script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({page_type:"brand_site",page_name:"{{ pageKey }}",site_version:"brand-site-v2"});</script>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-PCDJZ9X9");</script>
</head>
<body class="brand-site page-{{ pageKey }}">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PCDJZ9X9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  {% if pageKey == "home" %}
  <div class="brand-opening" aria-hidden="true">
    <div class="brand-opening-orbit"></div>
    <img class="brand-opening-logo" src="/images/logo-yoko1.png" alt="">
    <p>WELLNESS, DESIGNED FOR YOU.</p>
  </div>
  {% endif %}

  <header class="site-header site-header--overlay" id="site-brand-header">
    <a class="site-logo" href="/" aria-label="ZenNu WELLNESS DESIGN トップへ"><img src="/images/logo-yoko.png" alt="ZenNu WELLNESS DESIGN"></a>
    <nav class="site-nav" aria-label="メインメニュー">
      <a href="/concept/"{% if pageKey == "concept" %} aria-current="page"{% endif %}>私たちについて</a>
      <a href="/service/"{% if pageKey == "service" %} aria-current="page"{% endif %}>サービス</a>
      <a href="/price/"{% if pageKey == "price" %} aria-current="page"{% endif %}>料金</a>
      <a href="/results/"{% if pageKey == "results" %} aria-current="page"{% endif %}>実績</a>
      <a href="/trainers/"{% if pageKey == "trainers" %} aria-current="page"{% endif %}>トレーナー</a>
      <a href="/facility/"{% if pageKey == "facility" %} aria-current="page"{% endif %}>施設</a>
      <a href="/access/"{% if pageKey == "access" %} aria-current="page"{% endif %}>アクセス</a>
    </nav>
    <a class="site-header-cta" href="{{ trialUrl }}" target="_blank" rel="noopener" data-cta="header"><small>TRIAL</small><strong>無料体験を予約</strong></a>
    <button class="site-menu-button" type="button" aria-label="メニューを開く" aria-controls="site-mobile-menu" aria-expanded="false"><i></i><i></i></button>
  </header>

  <div class="site-mobile-menu" id="site-mobile-menu" aria-hidden="true">
    <nav aria-label="スマートフォンメニュー">
      <a href="/concept/"><small>01</small>私たちについて</a>
      <a href="/service/"><small>02</small>サービス</a>
      <a href="/price/"><small>03</small>料金・プラン</a>
      <a href="/results/"><small>04</small>会員実績</a>
      <a href="/trainers/"><small>05</small>トレーナー</a>
      <a href="/facility/"><small>06</small>施設・設備</a>
      <a href="/access/"><small>07</small>アクセス</a>
      <a href="/faq/"><small>08</small>よくある質問</a>
      <a href="/blog/"><small>09</small>コラム</a>
    </nav>
    <a class="site-mobile-reserve" href="{{ trialUrl }}" target="_blank" rel="noopener" data-cta="mobile_menu">無料体験を予約する</a>
  </div>

  {{ content | safe }}

  <section class="site-contact" aria-labelledby="contact-title">
    <div class="site-shell site-contact-grid">
      <div><p class="site-contact-en">START WITH A CONVERSATION.</p><h2 id="contact-title">まずは、今の悩みを<br>聞かせてください。</h2></div>
      <div><p>体験後の入会は任意です。パーソナルだけ、セルフだけ、組み合わせ。目標と生活に合う通い方からご案内します。</p><a class="site-contact-button" href="{{ trialUrl }}" target="_blank" rel="noopener" data-cta="footer">無料体験を予約する<span>→</span></a><a class="site-contact-line" href="{{ site.contact.lineUrl }}" target="_blank" rel="noopener" data-cta="line">LINEで相談する</a></div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="site-shell site-footer-top">
      <div class="site-footer-brand"><img src="/images/logo-yoko.png" alt="ZenNu WELLNESS DESIGN"><p>〒860-0845 熊本県熊本市中央区上通町6-15<br>オークス第二ビル 2F</p></div>
      <div class="site-footer-sitemap">
        <a href="/concept/">熊本・上通のZenNuについて</a><a href="/service/">パーソナル・セルフのサービス</a><a href="/price/">料金・プラン</a><a href="/results/">会員実績・お客様の声</a><a href="/trainers/">トレーナー・資格</a><a href="/facility/">上通店舗の施設・設備</a><a href="/access/">上通店舗へのアクセス</a><a href="/faq/">体験・契約のよくある質問</a><a href="/blog/">トレーニング・食事コラム</a>
      </div>
    </div>
    <div class="site-shell site-footer-bottom"><div><a href="/terms/">利用規約</a><a href="/privacy/">プライバシーポリシー</a><a href="/law/">特定商取引法に基づく表記</a></div><p>© 2026 ZenNu WELLNESS DESIGN</p></div>
  </footer>

  <a class="site-sticky-cta" href="{{ trialUrl }}" target="_blank" rel="noopener" data-cta="sticky"><small>初回限定</small><strong>無料体験を予約</strong><span>→</span></a>

  <script>
    (() => {
      const header = document.getElementById("site-brand-header");
      const button = document.querySelector(".site-menu-button");
      const menu = document.getElementById("site-mobile-menu");
      const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
      updateHeader(); window.addEventListener("scroll", updateHeader, {passive:true});
      const opening = document.querySelector(".brand-opening");
      if (opening) window.setTimeout(() => opening.remove(), 3400);
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        menu?.setAttribute("aria-hidden", String(open));
        document.body.classList.toggle("menu-open", !open);
      });
      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        button?.setAttribute("aria-expanded", "false"); menu?.setAttribute("aria-hidden", "true"); document.body.classList.remove("menu-open");
      }));
      document.querySelectorAll("[data-cta]").forEach((link) => link.addEventListener("click", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({event:"cta_click",cta_location:link.dataset.cta,page_name:"{{ pageKey }}"});
        if (typeof window.fbq === "function") window.fbq("track", "Contact", {content_name:"{{ pageKey }}",content_category:link.dataset.cta});
      }));
    })();
  </script>
</body>
</html>
