  <script>
    (() => {
      const track = document.querySelector('.sg-trainer-track');
      const cards = track ? [...track.querySelectorAll('.sg-trainer')] : [];
      let current = 0;
      const showTrainer = (direction) => {
        if (!cards.length) return;
        current = (current + direction + cards.length) % cards.length;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        cards[current].scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      };
      document.querySelector('.sg-trainer-prev')?.addEventListener('click', () => showTrainer(-1));
      document.querySelector('.sg-trainer-next')?.addEventListener('click', () => showTrainer(1));
    })();
  </script>

