{% set trialUrl = "https://zennuwellnessdesign.hacomono.jp/reserve/schedule/1/1/?trial=true" %}
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ site.meta.title }} | CP6</title>
  <meta name="description" content="パーソナル・セルフトレーニング・ピラティスを、一人ひとりに合わせて。熊本市中央区・上通のZenNu WELLNESS DESIGN。初回体験受付中。">
  <link rel="canonical" href="{{ site.meta.url }}/cp6lp/">
  <meta name="robots" content="noindex,follow">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ZenNu WELLNESS DESIGN">
  <meta property="og:title" content="{{ site.meta.title }}">
  <meta property="og:description" content="パーソナル・セルフトレーニング・ピラティスを、一人ひとりに合わせて。">
  <meta property="og:url" content="{{ site.meta.url }}/cp6lp/">
  <meta property="og:image" content="{{ site.meta.url }}/images/studio-hero-original.jpg">
  <link rel="icon" href="/favicon.ico">
  <link rel="preload" as="image" href="/images/studio-hero-original.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600&family=EB+Garamond:wght@400;500;600&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet">
  {% include "cp6-premium-style.njk" %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"HealthClub","name":"ZenNu WELLNESS DESIGN","url":"{{ site.meta.url }}/","image":"{{ site.meta.url }}/images/studio-hero-original.jpg","telephone":"{{ site.contact.telDisplay }}","priceRange":"¥¥","address":{"@type":"PostalAddress","postalCode":"860-0845","addressRegion":"熊本県","addressLocality":"熊本市中央区","streetAddress":"上通町6-15 オークス第二ビル 2F","addressCountry":"JP"},"geo":{"@type":"GeoCoordinates","latitude":"{{ site.meta.lat }}","longitude":"{{ site.meta.lng }}"}}
  </script>
  <script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({page_type:"landing_page",lp_variant:"cp6lp",lp_appeal:"premium_hybrid"});</script>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-PCDJZ9X9");</script>
</head>
<body class="sglp">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PCDJZ9X9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <main>
    <section class="sg-hero" id="top" aria-labelledby="sg-hero-title">
      <img class="sg-hero-image" src="/images/studio-hero-original.jpg" alt="ZenNuのパーソナルトレーニング" fetchpriority="high">
      <div class="sg-hero-shade" aria-hidden="true"></div>
      <div class="sg-hero-logo"><img src="/images/logo-yoko.png" alt="ZenNu WELLNESS DESIGN"></div>
      <div class="sg-hero-copy">
        <p class="sg-kicker">PERSONAL × SELF TRAINING × PILATES</p>
        <h1 id="sg-hero-title">プロの指導を、<span>無理なく続く日常へ。</span></h1>
        <p>教わる日も、自分で続ける日も。<br>あなたの目標・生活・予算に合わせて選べるジム。</p>
      </div>
      <div class="sg-hero-brand">
        <span>OUR PHILOSOPHY</span>
        <strong>TRAIN YOUR WAY,<br>KEEP GOING.</strong>
      </div>
      <a class="sg-hero-offer" href="#campaign" aria-label="初回限定キャンペーンの詳細を見る">
        <span>9割以上が運動初心者</span>
        <strong>初回体験 <b>0</b>円</strong>
        <small>入会金0円・ダイエットガイド付</small>
      </a>
    </section>

    <section class="sg-proof" aria-label="ZenNuの特徴">
      <div><b>300<small>名以上</small></b><span>指導実績</span></div>
      <div><b>10,890<small>円〜</small></b><span>月額プラン</span></div>
      <div><b>徒歩2<small>分</small></b><span>通町筋駅から</span></div>
    </section>

    <section class="sg-campaign" id="campaign">
      <div class="sg-inner">
        <header class="sg-heading sg-heading-center">
          <p>LIMITED CAMPAIGN</p>
          <h2>始めるきっかけを、<br>3つの特典で。</h2>
        </header>
        <div class="sg-campaign-grid">
          <article><span>01</span><p>初回体験</p><strong>0<small>円</small></strong></article>
          <article><span>02</span><p>当日入会で入会金</p><strong>0<small>円</small></strong></article>
          <article><span>03</span><p>個別ダイエットガイド</p><strong class="sg-gift">無料<br>プレゼント</strong></article>
        </div>
        <a class="sg-button" href="{{ trialUrl }}" target="_blank" rel="noopener"><span>30秒で予約完了</span>無料体験の空き状況を見る<i>→</i></a>
        <p class="sg-note">※入会金無料は当日入会時。体験後の無理な勧誘はありません。</p>
      </div>
    </section>

    <section class="sg-concept">
      <div class="sg-inner sg-concept-grid">
        <div>
          <p class="sg-vertical">Z E N N U&nbsp;&nbsp; W E L L N E S S&nbsp;&nbsp; D E S I G N</p>
          <h2>ひとつのジムで、<br>3つの選択肢。</h2>
        </div>
        <div class="sg-concept-copy">
          <p>高額なパーソナルだけでも、自己流のセルフだけでもない。</p>
          <p>必要な時にプロから学び、自分のペースで実践し、ピラティスで身体の使い方まで整える。</p>
          <strong>続けやすさと結果を、どちらも諦めないためのハイブリッドジムです。</strong>
        </div>
      </div>
    </section>

    <section class="sg-services" id="services">
      <header class="sg-heading sg-heading-center sg-heading-light">
        <p>CHOOSE YOUR STYLE</p>
        <h2>その日の目的で、選べる。</h2>
      </header>
      <div class="sg-service-list">
        <article class="sg-service">
          <img src="/images/personal1.jpg" alt="トレーナーと行うパーソナルトレーニング" loading="lazy">
          <div><span>01 / PERSONAL</span><h3>プロと、最短距離で。</h3><p>姿勢・体力・目標を見極め、専用メニューを設計。正しいフォームと食事の考え方まで丁寧に伴走します。</p></div>
        </article>
        <article class="sg-service">
          <img src="/images/fastlane-self-use.jpg" alt="ZenNuでセルフトレーニングをする女性" loading="lazy">
          <div><span>02 / SELF TRAINING</span><h3>学んだことを、日常に。</h3><p>予約制の落ち着いた空間でセルフ利用。トレーナー常駐時間はフォームやメニューも相談できます。</p></div>
        </article>
        <article class="sg-service">
          <img src="/images/fastlane-pilates-bright.jpg" alt="ZenNuのマシンピラティス" loading="lazy">
          <div><span>03 / PILATES</span><h3>鍛える前に、整える。</h3><p>マシンピラティスで姿勢と動作を整え、トレーニング効果を高めます。運動が苦手な方にもおすすめです。</p></div>
        </article>
      </div>
    </section>

    <section class="sg-reasons" id="features">
      <div class="sg-inner">
        <header class="sg-heading sg-heading-light">
          <p>WHY ZENNU</p>
          <h2>続けられることが、<br>結果につながる。</h2>
        </header>
        <div class="sg-reason-grid">
          <article><span>01</span><h3>300名以上の指導実績</h3><p>幅広い年代・目標に対応してきた経験から、今の身体に合う進め方を提案します。</p></article>
          <article><span>02</span><h3>プロにいつでも相談</h3><p>セルフ利用時も、トレーナー常駐時間はフォームやメニューをその場で確認できます。</p></article>
          <article><span>03</span><h3>完全予約・少人数制</h3><p>混雑を避け、人目を気にせず集中できる環境。予定に組み込むことで習慣化も支えます。</p></article>
          <article><span>04</span><h3>炭水化物も食べられる</h3><p>極端な糖質制限ではなく、代謝を整えながら一生続けられる食事の考え方をお伝えします。</p></article>
          <article><span>05</span><h3>手ぶらで通える</h3><p>ウェア・シューズ・タオル・飲料水が無料。男女別シャワールームも完備しています。</p></article>
          <article><span>06</span><h3>朝7時から夜22時まで</h3><p>上通アーケード内、通町筋駅から徒歩2分。仕事や買い物の前後にも通いやすい立地です。</p></article>
        </div>
      </div>
    </section>

    <section class="sg-results" id="results">
      <div class="sg-inner">
        <header class="sg-heading">
          <p>MEMBER RESULTS</p>
          <h2>続けた先の、変化。</h2>
        </header>
        <div class="sg-result-scroll">
          {% for voice in site.memberVoice.items %}{% if loop.index <= 3 %}
          <article class="sg-result-card">
            <img src="{{ voice.image }}" alt="{{ voice.meta }}のビフォーアフター" loading="lazy">
            <div>
              <p>{{ voice.meta }}</p>
              <strong>{{ voice.result }}<small>{{ voice.unit }}</small></strong>
              <span>{{ voice.label }}</span>
              <blockquote>{{ voice.quote }}</blockquote>
            </div>
          </article>
          {% endif %}{% endfor %}
        </div>
        <p class="sg-note sg-left">※結果には個人差があり、効果を保証するものではありません。</p>
      </div>
    </section>

    <section class="sg-trainers" id="trainer">
      <div class="sg-inner">
        <header class="sg-heading sg-heading-center">
          <p>PERSONAL TRAINERS</p>
          <h2>人で選ばれる、指導を。</h2>
        </header>
        <div class="sg-trainer-grid">
          <article class="sg-trainer">
            <img src="/images/trainer-mori-portrait.jpg" alt="代表トレーナー 森丈明" loading="lazy">
            <div>
              <p>代表トレーナー / 森 丈明</p>
              <h3>TAKEAKI <span>MORI</span></h3>
              <div class="sg-tags"><span>ダイエット</span><span>ボディメイク</span><span>食事指導</span></div>
              <p class="sg-trainer-bio">「続けられること」を何より大切にし、初心者の挫折ゼロを目指すトレーナー。運動と食事の両面から、無理なく変わるための道筋をつくります。</p>
            </div>
          </article>
          <article class="sg-trainer">
            <img src="/images/trainer-kaneko-portrait.jpg" alt="トレーナー 金子亮太" loading="lazy">
            <div>
              <p>トレーナー / 金子 亮太</p>
              <h3>RYOTA <span>KANEKO</span></h3>
              <div class="sg-tags"><span>ボディメイク</span><span>初心者歓迎</span><span>姿勢改善</span></div>
              <p class="sg-trainer-bio">一人ひとりの目標とペースに寄り添う丁寧な指導が強み。運動が初めての方にも、無理なく続けられるプログラムをご提案します。</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="sg-pricing" id="price">
      <div class="sg-inner">
        <header class="sg-heading sg-heading-center">
          <p>PRICE SYSTEM</p>
          <h2>目標とペースで選べる料金。</h2>
        </header>
        <div class="sg-admission"><span>入会金</span><strong>11,000円</strong><b>当日入会で 0円</b></div>
        <div class="sg-price-grid">
          {% for plan in site.pricing.plans %}
          <article class="sg-plan{% if plan.popular %} sg-plan-popular{% endif %}">
            {% if plan.popular %}<span class="sg-popular">MOST POPULAR</span>{% endif %}
            <header><h3>{{ plan.name }}</h3><p>{{ plan.for }}</p></header>
            <div class="sg-plan-price"><strong>{{ plan.price }}</strong><small>{{ plan.unit }}</small></div>
            <ul>{% for item in plan.items %}<li>{{ item }}</li>{% endfor %}</ul>
            <a href="{{ trialUrl }}" target="_blank" rel="noopener">このプランを体験する <span>→</span></a>
          </article>
          {% endfor %}
        </div>
        <div class="sg-ticket">
          <div><p>PERSONAL TICKET</p><h3>{{ site.pricing.ticket.title }}</h3><span>{{ site.pricing.ticket.sub }}</span></div>
          <div class="sg-ticket-list">
            {% for ticket in site.pricing.ticket.cards %}
            <p><b>{{ ticket.count }}回</b><strong>{{ ticket.price }}</strong><small>{{ ticket.per }}</small></p>
            {% endfor %}
          </div>
        </div>
        <p class="sg-price-note">{{ site.pricing.note | safe }}</p>
      </div>
    </section>

    <section class="sg-gallery" id="gallery">
      <header class="sg-heading sg-heading-center sg-heading-light">
        <p>STUDIO GALLERY</p>
        <h2>通いたくなる、上質な空間。</h2>
      </header>
      <div class="sg-gallery-grid">
        <figure><img src="/images/training-area.jpg" alt="トレーニングエリア" loading="lazy"><figcaption>TRAINING AREA</figcaption></figure>
        <figure><img src="/images/counter.jpg" alt="エントランス" loading="lazy"><figcaption>ENTRANCE</figcaption></figure>
        <figure><img src="/images/lounge.jpg" alt="ラウンジ" loading="lazy"><figcaption>LOUNGE</figcaption></figure>
        <figure><img src="/images/facility-locker-shower-img3623.jpg" alt="ロッカーとシャワー" loading="lazy"><figcaption>LOCKER &amp; SHOWER</figcaption></figure>
        <figure><img src="/images/fastlane-self-use.jpg" alt="セルフトレーニング" loading="lazy"><figcaption>SELF TRAINING</figcaption></figure>
        <figure><img src="/images/fastlane-pilates-bright.jpg" alt="マシンピラティス" loading="lazy"><figcaption>PILATES</figcaption></figure>
      </div>
    </section>

    <section class="sg-flow" id="flow">
      <div class="sg-inner">
        <header class="sg-heading">
          <p>TRIAL FLOW</p>
          <h2>無料体験の流れ。</h2>
        </header>
        <ol class="sg-flow-list">
          <li><span>01</span><img src="/images/v3-flow-counseling.jpg" alt="カウンセリング" loading="lazy"><div><h3>カウンセリング</h3><p>目標・運動経験・生活リズムを丁寧に伺います。</p></div></li>
          <li><span>02</span><img src="/images/v3-flow-assessment.jpg" alt="姿勢と体組成のチェック" loading="lazy"><div><h3>身体をチェック</h3><p>体組成・姿勢・動作から、現在の身体を確認します。</p></div></li>
          <li><span>03</span><img src="/images/v3-flow-plan.jpg" alt="体験トレーニングとプラン提案" loading="lazy"><div><h3>体験・ご提案</h3><p>身体に合う内容を体験し、無理のない通い方をご提案します。</p></div></li>
        </ol>
      </div>
    </section>

    <section class="sg-access" id="access">
      <div class="sg-inner sg-access-grid">
        <div>
          <header class="sg-heading sg-heading-light"><p>ACCESS</p><h2>熊本・上通。<br>通町筋駅から徒歩2分。</h2></header>
          <dl>
            <div><dt>ADDRESS</dt><dd>〒860-0845<br>熊本県熊本市中央区上通町6-15<br>オークス第二ビル 2F</dd></div>
            <div><dt>OPEN</dt><dd>7:00〜22:00<br>パーソナル最終受付 20:00</dd></div>
            <div><dt>TEL</dt><dd><a href="tel:{{ site.contact.tel }}">{{ site.contact.telDisplay }}</a></dd></div>
          </dl>
        </div>
        <div class="sg-map"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3353.509069739915!2d130.7110942!3d32.8052741!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3540f52b888ea3ff%3A0x93c570239ee20bb6!2sZenNu%20WELLNESS%20DESIGN!5e0!3m2!1sja!2sjp!4v1785497232957!5m2!1sja!2sjp" title="ZenNu WELLNESS DESIGN Googleマップ" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
      </div>
    </section>

    <section class="sg-faq" id="faq">
      <div class="sg-inner">
        <header class="sg-heading sg-heading-center"><p>FAQ</p><h2>よくあるご質問。</h2></header>
        <div class="sg-faq-list">
          {% for item in site.faq.items %}
          <details{% if loop.first %} open{% endif %}><summary><span>Q</span>{{ item.q }}<i>＋</i></summary><div><b>A</b><p>{{ item.a }}</p></div></details>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="sg-reserve" id="reserve">
      <header class="sg-heading sg-heading-center"><p>BOOK A TRIAL</p><h2>空いている日時を選ぶ。</h2><span>プログラムは「カウンセリング＋体験トレーニング」をお選びください。</span></header>
      <iframe id="hacomono-widget-w0002" src="https://zennuwellnessdesign.hacomono.jp/widgets/2?isFilterableByCategory=false&isShowStudioInfo=true&studioIds=1" title="ZenNu無料体験予約"></iframe>
    </section>
    <script src="https://zennuwellnessdesign.hacomono.jp/js/widget.js"></script>
  </main>

  <footer class="sg-footer">
    <div><img src="/images/logo-yoko.png" alt="ZenNu WELLNESS DESIGN"><p>パーソナル × セルフ × ピラティスで、<br>続けられる身体づくりを。</p></div>
    <nav><a href="#services">サービス</a><a href="#features">特徴</a><a href="#results">実績</a><a href="#price">料金</a><a href="#trainer">トレーナー</a><a href="#access">アクセス</a><a href="#faq">FAQ</a></nav>
    <div class="sg-footer-links"><a href="/terms/">会員・施設利用規約</a><a href="/privacy/">プライバシーポリシー</a><a href="/law/">特定商取引法に基づく表記</a></div>
    <small>運営会社 株式会社GroVit ／ © 2026 ZenNu WELLNESS DESIGN</small>
  </footer>

  <div class="sg-sticky">
    <div><span>初回限定キャンペーン</span><strong>体験料・入会金 <b>0円</b></strong></div>
    <a href="{{ trialUrl }}" target="_blank" rel="noopener"><span>30秒で予約完了</span>空き状況をチェック <i>→</i></a>
  </div>

  {% include "click-tracking.njk" %}
</body>
</html>
