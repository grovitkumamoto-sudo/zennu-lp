---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.meta.url }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.meta.url }}/blog/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.meta.url }}/cp1lp/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% for path in ["concept", "service", "price", "results", "trainers", "facility", "access", "faq", "corporate-contact"] %}
  <url>
    <loc>{{ site.meta.url }}/{{ path }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url>
    <loc>{{ site.meta.url }}/terms/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.meta.url }}/corporate-terms/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.meta.url }}/privacy/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.meta.url }}/law/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
{%- for post in site.blogPosts %}
{%- if not post.noindex %}
  <url>
    <loc>{{ site.meta.url }}/blog/{{ post.slug }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
