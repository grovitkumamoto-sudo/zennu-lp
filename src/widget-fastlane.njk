<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PCDJZ9X9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <div class="fast-page">
    <header class="fast-header">
      <img src="/images/studio/93fa018970b42e1a.webp" alt="ZenNu WELLNESS DESIGN">
      <p>熊本・上通<br>初回体験無料</p>
    </header>

    <main>
      <section class="fast-gallery" aria-labelledby="fast-gallery-title">
        <div class="fast-gallery-head">
          <p class="fast-gallery-title" id="fast-gallery-title">GALLERY</p>
          <p class="fast-gallery-sub">{{ site.gallery.subtitle }}</p>
        </div>
        <div class="fast-gallery-grid">
          {% for g in site.gallery.items %}
          <figure class="fast-gallery-item{% if g.size %} {{ g.size }}{% endif %}">
            <img src="{{ g.image | mediaUrl }}" alt="{{ g.label }}"{% if loop.first %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
            <figcaption>{{ g.label }}</figcaption>
          </figure>
          {% if loop.index == 3 %}
          <figure class="fast-gallery-item">
            <img src="/images/fastlane-pilates-bright.jpg" alt="リフォーマーを使ったZenNuのピラティス指導" loading="lazy" decoding="async">
            <figcaption>PILATES</figcaption>
          </figure>
          <figure class="fast-gallery-item">
            <img src="/images/fastlane-self-use.jpg" alt="ZenNuでセルフトレーニングを行う会員" loading="lazy" decoding="async">
            <figcaption>SELF TRAINING</figcaption>
          </figure>
          {% endif %}
          {% endfor %}
        </div>
      </section>

      <section class="fast-offer" aria-labelledby="fast-title">
        <p class="fast-kicker">パーソナル×セルフのハイブリッドジム</p>
        <h1 id="fast-title">高額なパーソナルを、<br><em>続けやすい月額</em>へ。</h1>
        <p class="fast-offer-lead">プロに教わり、セルフで続ける。<br>必要なサポートを、無理のない価格で。</p>
        <div class="fast-price"><span>月額</span><strong>10,890</strong><small>円〜（税込）</small></div>
      </section>

      <div class="fast-points" aria-label="予約前に知っておきたい3つのポイント">
        <div class="fast-point"><b>初回体験<br>無料</b><small>当日の持ち物なし</small></div>
        <div class="fast-point"><b>初心者<br>歓迎</b><small>9割以上が初心者</small></div>
        <div class="fast-point"><b>通町筋駅<br>徒歩2分</b><small>提携駐車場あり</small></div>
      </div>

      <a class="fast-primary" id="fast-primary" href="#reserve" data-click-label="空き枠確認｜ファーストビュー" data-click-type="conversion"><small>初回<br>0円</small><strong>空き枠を確認する</strong><span aria-hidden="true">↓</span></a>

      <section class="fast-reserve" id="reserve" aria-labelledby="reserve-title">
        <div class="fast-reserve-head">
          <span>BOOK A TRIAL</span>
          <h2 id="reserve-title">空いている日時を選ぶ</h2>
          <p>プログラムは「カウンセリング＋体験トレーニング」をお選びください。</p>
        </div>
        <div class="fast-widget">
          <iframe id="hacomono-widget-w0002" src="https://zennuwellnessdesign.hacomono.jp/widgets/2?isFilterableByCategory=false&amp;isShowStudioInfo=true&amp;studioIds=1" title="ZenNu無料体験予約"></iframe>
        </div>
      </section>

      <section class="fast-reassurance" aria-labelledby="reassurance-title">
        <h2 id="reassurance-title">予約前の不安も、最小限に。</h2>
        <ul>
          <li>ウェア・シューズ・タオル・飲料水は無料</li>
          <li>運動初心者でも、トレーナーが丁寧にサポート</li>
          <li>体験後の無理な勧誘はありません</li>
        </ul>
      </section>

      <section class="fast-access" aria-labelledby="access-title">
        <h2 id="access-title">ZenNu WELLNESS DESIGN</h2>
        <p>〒860-0845 熊本県熊本市中央区上通町6-15 オークス第二ビル2F<br>営業時間 7:00〜22:00 ／ <a href="tel:{{ site.contact.tel }}">{{ site.contact.telDisplay }}</a></p>
      </section>
    </main>

    <footer class="fast-footer">
      <img src="/images/logo-yoko.png" alt="ZenNu WELLNESS DESIGN">
      <div class="fast-footer-links"><a href="/terms/">会員・施設利用規約</a><a href="/privacy/">プライバシーポリシー</a><a href="/law/">特定商取引法に基づく表記</a></div>
      <p>運営会社 株式会社GroVit ／ © 2026 ZenNu WELLNESS DESIGN</p>
    </footer>
  </div>

  <div class="fast-sticky is-hidden" id="fast-sticky"><a href="#reserve" data-click-label="空き枠確認｜固定CTA" data-click-type="conversion">無料体験の空き枠を見る</a></div>

  <script src="https://zennuwellnessdesign.hacomono.jp/js/widget.js"></script>
  {% include "click-tracking.njk" %}
  <script>
    (() => {
      const primary = document.getElementById("fast-primary");
      const reserve = document.getElementById("reserve");
      const sticky = document.getElementById("fast-sticky");
      let primaryVisible = true;
      let reserveVisible = false;
      const updateSticky = () => sticky.classList.toggle("is-hidden", primaryVisible || reserveVisible);
      new IntersectionObserver(entries => {
        primaryVisible = entries[0].isIntersecting;
        updateSticky();
      }, { threshold: .1 }).observe(primary);
      new IntersectionObserver(entries => {
        reserveVisible = entries[0].isIntersecting;
        updateSticky();
      }, { threshold: .08 }).observe(reserve);
    })();
  </script>
</body>
