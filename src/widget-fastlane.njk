  <style>
    :root{--ink:#1a1a1a;--muted:#666;--light:#999;--line:#e8e0d8;--paper:#faf7f3;--orange:#e87030;--orange-dark:#d4612a;--white:#fff;--shadow:0 18px 48px rgba(38,29,23,.12)}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:#171513;scroll-padding-top:12px}
    body{margin:0;background:#171513;color:var(--ink);font-family:"Montserrat","Noto Sans JP",sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    img,video{display:block;width:100%}
    button{font:inherit}
    .fast-page{width:min(100%,430px);min-height:100vh;margin:0 auto;background:var(--white);box-shadow:0 0 54px rgba(0,0,0,.5);overflow:hidden}
    .fast-header{display:flex;height:64px;align-items:center;justify-content:space-between;padding:0 20px;background:var(--white);border-bottom:1px solid var(--line)}
    .fast-header img{width:142px;height:auto;filter:brightness(0)}
    .fast-header p{margin:0;color:var(--orange);font-size:9px;font-weight:800;line-height:1.45;letter-spacing:.05em;text-align:right}
    .fast-gallery{padding:25px 14px 14px;background:var(--paper)}
    .fast-gallery-head{display:flex;align-items:flex-end;justify-content:space-between;margin:0 2px 20px}
    .fast-gallery-title{margin:0;font-size:clamp(38px,12vw,52px);font-weight:900;line-height:.88;letter-spacing:-.055em}
    .fast-gallery-sub{margin:0 0 2px;color:var(--muted);font-size:9px;font-weight:700;letter-spacing:.04em;text-align:right}
    .fast-gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(105px,29vw,125px);gap:8px}
    .fast-gallery-item{position:relative;margin:0;overflow:hidden;background:linear-gradient(135deg,#ece3d7,#dbcbb7)}
    .fast-gallery-item::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.48),transparent 42%);pointer-events:none}
    .fast-gallery-item img{height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.22,1,.36,1)}
    .fast-gallery-item figcaption{position:absolute;z-index:1;right:12px;bottom:10px;left:12px;color:#fff;font-size:9px;font-weight:700;line-height:1;letter-spacing:.15em}
    .fast-gallery-item.g-large{grid-column:span 2;grid-row:span 2}
    .fast-gallery-item.g-wide{grid-column:span 2}
    .fast-offer{position:relative;padding:34px 20px 22px;background:var(--white)}
    .fast-kicker{margin:0 0 10px;color:var(--orange);font-size:10px;font-weight:800;letter-spacing:.08em}
    .fast-offer h1{margin:0;font-size:29px;font-weight:900;line-height:1.4;letter-spacing:-.05em}
    .fast-offer h1 em{color:var(--orange);font-style:normal}
    .fast-offer-lead{margin:10px 0 0;color:var(--muted);font-size:12px;font-weight:700;line-height:1.75}
    .fast-price{display:flex;align-items:flex-end;gap:6px;margin-top:15px;color:var(--ink)}
    .fast-price span{padding-bottom:5px;font-size:11px;font-weight:900}
    .fast-price strong{color:var(--orange);font:800 33px/.95 "Montserrat",sans-serif;letter-spacing:-.04em}
    .fast-price small{padding-bottom:3px;font-size:10px;font-weight:800}
    .fast-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .fast-point{display:grid;min-height:76px;place-items:center;padding:11px 4px;text-align:center}
    .fast-point+.fast-point{border-left:1px solid var(--line)}
    .fast-point b{font-size:12px;font-weight:900;line-height:1.35}
    .fast-point small{display:block;margin-top:4px;color:var(--muted);font-size:8px;font-weight:700;line-height:1.35}
    .fast-primary{display:grid;grid-template-columns:42px 1fr 20px;align-items:center;min-height:62px;margin:18px 16px 22px;padding:7px 14px;background:var(--orange);color:#fff;box-shadow:0 12px 25px rgba(232,112,48,.25)}
    .fast-primary small{display:grid;width:40px;height:40px;place-items:center;border-radius:50%;background:#fff;color:var(--orange-dark);font-size:8px;font-weight:900;line-height:1.25;text-align:center}
    .fast-primary strong{font-size:17px;font-weight:900;text-align:center}
    .fast-primary span{font-size:19px;text-align:right}
    .fast-reserve{padding:32px 0 0;background:var(--paper)}
    .fast-reserve-head{padding:0 18px 18px;text-align:center}
    .fast-reserve-head span{color:var(--orange);font:800 10px/1 "Montserrat",sans-serif;letter-spacing:.18em}
    .fast-reserve-head h2{margin:8px 0 7px;font-size:23px;font-weight:900;letter-spacing:-.045em}
    .fast-reserve-head p{margin:0;color:var(--muted);font-size:11px;font-weight:700;line-height:1.7}
    .fast-widget{min-height:1850px;background:#fff;border-top:1px solid var(--line)}
    .fast-widget iframe{display:block;width:100%;min-height:2250px;border:0}
    .fast-reassurance{padding:32px 18px 38px;background:var(--ink);color:#fff}
    .fast-reassurance h2{margin:0 0 18px;font-size:19px;font-weight:900;text-align:center}
    .fast-reassurance ul{display:grid;gap:9px;margin:0;padding:0;list-style:none}
    .fast-reassurance li{position:relative;padding:12px 12px 12px 39px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);font-size:11px;font-weight:800;line-height:1.55}
    .fast-reassurance li::before{content:"✓";position:absolute;top:11px;left:14px;color:var(--orange);font-size:16px;font-weight:900}
    .fast-access{padding:28px 18px;background:#fff}
    .fast-access h2{margin:0 0 12px;font-size:17px;font-weight:900}
    .fast-access p{margin:0;color:var(--muted);font-size:10px;font-weight:700;line-height:1.9}
    .fast-access a{font-weight:900;text-decoration:underline;text-underline-offset:3px}
    .fast-footer{padding:24px 18px 100px;background:#211f1e;color:#bbb;text-align:center}
    .fast-footer img{width:160px;margin:0 auto 16px;filter:brightness(0) invert(1)}
    .fast-footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 14px}
    .fast-footer-links a{font-size:8px;text-decoration:underline;text-underline-offset:2px}
    .fast-footer p{margin:16px 0 0;font-size:8px}
    .fast-sticky{position:fixed;z-index:20;right:auto;bottom:0;left:50%;display:grid;width:min(100%,430px);padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:rgba(255,255,255,.94);box-shadow:0 -8px 24px rgba(25,20,17,.13);transform:translateX(-50%);transition:opacity .2s,visibility .2s}
    .fast-sticky.is-hidden{visibility:hidden;opacity:0;pointer-events:none}
    .fast-sticky a{display:flex;min-height:52px;align-items:center;justify-content:center;background:var(--orange);color:#fff;font-size:15px;font-weight:900;box-shadow:0 8px 18px rgba(232,112,48,.22)}
    @media(min-width:431px){.fast-page{margin-top:18px;margin-bottom:18px;border-radius:14px}.fast-sticky{bottom:18px;border-radius:12px}}
    @media(hover:hover){.fast-gallery-item:hover img{transform:scale(1.05)}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.fast-gallery-item img{transition:none}}
  </style>
