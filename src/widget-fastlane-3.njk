  <script>
    (function(){
      var label=document.getElementById("campaign-period");
      function updateCampaignPeriod(){
        var parts=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Tokyo",year:"numeric",month:"numeric"}).formatToParts(new Date());
        var year=Number(parts.find(function(part){return part.type==="year";}).value);
        var month=Number(parts.find(function(part){return part.type==="month";}).value);
        var lastDay=new Date(Date.UTC(year,month,0)).getUTCDate();
        label.textContent=month+"/1〜"+month+"/"+lastDay;
      }
      updateCampaignPeriod();
      document.addEventListener("visibilitychange",function(){if(!document.hidden)updateCampaignPeriod();});
      setInterval(updateCampaignPeriod,60000);
    })();
  </script>
