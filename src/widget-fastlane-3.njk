    .campaign-highlight strong{display:block;margin-top:4px;color:#fff;font-size:20px;font-weight:800;line-height:1.2;letter-spacing:-.055em}
    .campaign-period{display:grid;flex:none;gap:4px;min-width:108px;margin:0;padding:8px 9px;background:#d4bf91;color:var(--ink);text-align:center}
    .campaign-period span{font-size:8px;font-weight:700;line-height:1.2}
