    .access-kicker{margin:0 0 5px;color:#514832;font:700 9px/1 "Barlow Condensed",sans-serif;letter-spacing:.14em}
    .access h2{margin:0;font-size:14px;font-weight:800;line-height:1.35;letter-spacing:-.04em}
    .access address{margin:4px 0 0;color:#49483f;font-size:9px;font-style:normal;line-height:1.35}
    .access a{display:inline-flex;min-height:39px;flex:none;align-items:center;gap:7px;padding:0 10px;border:1px solid var(--ink);background:var(--ink);color:#fff;font:700 9px/1 "DM Sans",sans-serif;letter-spacing:.04em;white-space:nowrap}
    .access a span{color:#d4bf91;font-size:15px;line-height:1}
    .more{padding:24px 22px 29px;background:#e8e6de}
    .more p{margin:0 0 10px;color:#686961;font-size:10px;font-weight:500;line-height:1.6}
    .more a{display:flex;min-height:48px;align-items:center;justify-content:space-between;padding:0 15px;border:1px solid var(--ink);background:var(--ink);color:#fff;font-size:13px;font-weight:700;letter-spacing:-.02em}
    .more a span{color:#d2bb82;font:500 20px/1 "DM Sans",sans-serif}
    .footer{padding:24px 22px 34px;background:var(--ink);color:#a6a8a0}
